RunService:BindToRenderStep("KhangThirdPerson", Enum.RenderPriority.Camera.Value + 1, function()
    if not Features.ThirdPerson then
        if tpActive then
            tpActive = false
            tpLastCFrame = nil
            pcall(function()
                LocalPlayer.CameraMaxZoomDistance = tpSavedMaxZoom
                LocalPlayer.CameraMinZoomDistance = tpSavedMinZoom
                LocalPlayer.CameraMode = tpSavedMode
            end)
        end
        return
    end

    if not tpActive then
        tpActive = true
        tpSavedMaxZoom = LocalPlayer.CameraMaxZoomDistance
        tpSavedMinZoom = LocalPlayer.CameraMinZoomDistance
        tpSavedMode = LocalPlayer.CameraMode
    end

    -- Mở khóa zoom của Roblox (dùng cho game camera mặc định)
    pcall(function()
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMaxZoomDistance = math.max(Features.TPDistance + 10, 128)
        LocalPlayer.CameraMinZoomDistance = 0.5
    end)

    local char = LocalPlayer.Character
    if not char then return end

    -- Hiện lại thân nhân vật (game thường ẩn khi ở góc nhìn thứ nhất)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.LocalTransparencyModifier = 0 end
    end

    -- Nếu game chưa cập nhật camera trong frame này thì không cộng thêm khoảng lùi lần nữa
    local cf = Camera.CFrame
    if tpLastCFrame and cf == tpLastCFrame then return end

    local desired = cf * CFrame.new(0, 0, Features.TPDistance)
    local dir = desired.Position - cf.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    local hit = Workspace:Raycast(cf.Position, dir, params)
    local pos = hit and (hit.Position - dir.Unit * 0.5) or desired.Position

    local newCF = CFrame.new(pos) * (cf - cf.Position)
    Camera.CFrame = newCF
    tpLastCFrame = newCF
end)

