    -- ---------- Dựng panel ----------
    local PANEL_W, GAP = 180, 16

    relayout = function()
        local scale = Features.PanelScale / 100
        local totalW = #panels * PANEL_W * scale + (#panels - 1) * GAP
        local startX = math.max(10, (Camera.ViewportSize.X - totalW) / 2)
        for _, p in ipairs(panels) do
            p.frame.Position = UDim2.new(0, startX + (p.index - 1) * (PANEL_W * scale + GAP), 0, 100)
        end
    end

    for i, cat in ipairs(Layout) do
        local Panel = new("Frame", {
            Name = cat.name,
            Position = UDim2.new(0, 0, 0, 100),
            Size = UDim2.new(0, PANEL_W, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = COLORS.panel,
            BackgroundTransparency = Features.PanelTransparency / 100,
            BorderSizePixel = 0,
        }, ClickGui)
        track(Panel, "BackgroundColor3", "panel")
        local PanelCorner = new("UICorner", {CornerRadius = UDim.new(0, Features.PanelCorner)}, Panel)
        local PanelScale = new("UIScale", {Scale = Features.PanelScale / 100}, Panel)
        table.insert(panels, {frame = Panel, corner = PanelCorner, scale = PanelScale, index = i})
        new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}, Panel)
        new("UIPadding", {PaddingBottom = UDim.new(0, 8)}, Panel)

        local Header = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = 1,
            Text = cat.name,
            TextColor3 = COLORS.text,
            TextSize = 15,
            Font = Enum.Font.GothamMedium,
            AutoButtonColor = false,
            LayoutOrder = 0,
        }, Panel)

        Header.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local dragStart, startPos = input.Position, Panel.Position
                activeDrag = function(moveInput)
                    local delta = moveInput.Position - dragStart
                    Panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                end
            end
        end)

        for order, mod in ipairs(cat.modules) do
            createModule(Panel, mod, order)
        end
    end

    relayout()
    updateMenus()

    setPanelStyle = function(index)
        setFeature("PanelStyle", index)
    end
    runDeleteScript = function(btn)
        deleteScriptAction(btn)
    end
    cycleSkyPreset = function()
        local nextIndex = (Features.SkyPreset % #SKY_PRESETS) + 1
        setFeature("SkyPreset", nextIndex)
        return SKY_PRESETS[nextIndex].name
    end

    -- ---------- Phím tắt ----------
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if khangUnloaded then return end

        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local mod = listening
                listening = nil
                if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                    mod.bind = nil
                    mod.bindButton.Text = "Bind: None"
                elseif input.KeyCode ~= Enum.KeyCode.RightShift then
                    mod.bind = input.KeyCode
                    mod.bindButton.Text = "Bind: " .. input.KeyCode.Name
                else
                    mod.bindButton.Text = mod.bind and ("Bind: " .. mod.bind.Name) or "Bind: None"
                end
            end
            return
        end

        if gameProcessed then return end

        if input.KeyCode == Enum.KeyCode.RightShift then
            menuOpen = not (ClickGui.Visible or MainFrame.Visible)
            updateMenus()
            return
        end

        for _, mod in ipairs(allModules) do
            if mod.bind and input.KeyCode == mod.bind then
                triggerModule(mod)
            end
        end
    end)
