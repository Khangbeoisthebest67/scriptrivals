Lib.StyleNames = {"Sidebar", "Top Tabs", "Click GUI"}

function Lib:SetStyle(style)
    if type(style) == "string" then
        for i, n in ipairs(Lib.StyleNames) do
            if n == style then style = i end
        end
    end
    if type(style) ~= "number" then return end
    style = math.clamp(math.floor(style), 1, 3)
    self.Style = style

    local side = self.Sidebar
    if style == 1 then
        side.Visible = true
        side.Position, side.Size = UDim2.new(0, 0, 0, 38), UDim2.new(0, 130, 1, -38)
        side.AutomaticCanvasSize = Enum.AutomaticSize.Y
        side.ScrollingDirection = Enum.ScrollingDirection.Y
        self.SideLayout.FillDirection = Enum.FillDirection.Vertical
        self.Pages.Position, self.Pages.Size = UDim2.new(0, 130, 0, 38), UDim2.new(1, -130, 1, -38)
    elseif style == 2 then
        side.Visible = true
        side.Position, side.Size = UDim2.new(0, 0, 0, 38), UDim2.new(1, 0, 0, 38)
        side.AutomaticCanvasSize = Enum.AutomaticSize.X
        side.ScrollingDirection = Enum.ScrollingDirection.X
        self.SideLayout.FillDirection = Enum.FillDirection.Horizontal
        self.Pages.Position, self.Pages.Size = UDim2.new(0, 0, 0, 76), UDim2.new(1, 0, 1, -76)
    else
        side.Visible = false
    end

    for i, tab in ipairs(self.Tabs) do
        if style == 3 then
            tab.Button.Visible = false
            tab.Page.Parent = tab.Body
            tab.Page.Size = UDim2.new(1, 0, 1, 0)
            tab.Page.Visible = true
            tab.Panel.Position = UDim2.fromOffset(20 + (i - 1) * 202, 50)
            tab.Panel.Visible = true
            tab.Resize()
        else
            tab.Panel.Visible = false
            tab.Button.Visible = true
            tab.Button.Size = (style == 1) and UDim2.new(1, 0, 0, 30) or UDim2.new(0, 96, 0, 28)
            tab.Page.Parent = self.Pages
            tab.Page.Size = UDim2.new(1, 0, 1, 0)
        end
    end

    if style ~= 3 then
        local cur = self.CurrentTab or self.Tabs[1]
        if cur then cur.Select() end
    end
    self.StyleBtn.Text = "UI: " .. Lib.StyleNames[style] .. "  ⇄"
    self:_updateVisible()
    if self.OnStyle then task.spawn(self.OnStyle, style) end
end

