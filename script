        local emitter = Instance.new("ParticleEmitter")
        emitter.Rate = 0
        emitter.Lifetime = NumberRange.new(1.2, 2)
        emitter.Speed = NumberRange.new(20, 40)
        emitter.SpreadAngle = Vector2.new(180, 180)
        emitter.Size = NumberSequence.new(0.5)
        emitter.Acceleration = Vector3.new(0, -30, 0)
        emitter.LightEmission = 0.4
        emitter.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
            ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 80)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 255, 120)),
            ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 160, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 220)),
        })
        emitter.Parent = anchor
        anchor.Parent = Workspace
        emitter:Emit(90)
        Debris:AddItem(anchor, 3)
    end

    local function runFinisher(index, char, pos)
        local effect = effects[index] or effects[1]
        pcall(effect, char, pos)
    end

    -- ---------- Phát hiện địch chết ----------
    local function onEnemyDied(player, char)
        if khangUnloaded or not Features.CustomFinisher or not isEnemy(player) then return end

        local root = char:FindFirstChild("HumanoidRootPart")
        local myRoot = getRoot()
        if not root or not myRoot then return end
        if (root.Position - myRoot.Position).Magnitude > Features.FinisherRange then return end

        if Features.FinisherOnScreen then
            local _, onScreen = Camera:WorldToViewportPoint(root.Position)
            if not onScreen then return end
        end

        runFinisher(Features.FinisherType, char, root.Position)

        if Features.FinisherEmote then
            Features.EmotePlay = true
            Custom.onEmoteToggle(true)
            notifyEmoteState()
        end
    end

    local hooked = setmetatable({}, {__mode = "k"})
    local function hookCharacter(player, char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum or hooked[hum] then return end
        hooked[hum] = true
        hum.Died:Connect(function()
            onEnemyDied(player, char)
        end)
    end

    local function hookPlayer(player)
        if player == LocalPlayer then return end
        if player.Character then
            task.spawn(hookCharacter, player, player.Character)
        end
        player.CharacterAdded:Connect(function(char)
            hookCharacter(player, char)
        end)
    end

    for _, player in ipairs(Players:GetPlayers()) do hookPlayer(player) end
    Players.PlayerAdded:Connect(hookPlayer)

    -- Xem thử hiệu ứng trên một bản sao đứng trước mặt
    function Custom.testFinisher()
        local char = LocalPlayer.Character
        local root = getRoot()
        if not char or not root then return end

        local wasArchivable = char.Archivable
        char.Archivable = true
        local dummy = char:Clone()
        char.Archivable = wasArchivable
        if not dummy then return end

        for _, d in ipairs(dummy:GetDescendants()) do
            if d:IsA("BaseScript") then
                d:Destroy()
            elseif d:IsA("BasePart") then
                d.Anchored = true
                d.CanCollide = false
            end
        end
        local dummyHum = dummy:FindFirstChildOfClass("Humanoid")
        if dummyHum then dummyHum:Destroy() end

        dummy:PivotTo(root.CFrame * CFrame.new(0, 0, -15))
        dummy.Parent = Workspace
        Debris:AddItem(dummy, 3.5)

        local dummyRoot = dummy:FindFirstChild("HumanoidRootPart")
        runFinisher(Features.FinisherType, dummy, dummyRoot and dummyRoot.Position or root.Position)
    end
end

-- ===== SKIN PACKS (lưu / áp dụng / chia sẻ loadout skin) =====
-- Pack dựng sẵn: thêm tại đây. Dùng nút "Dump Cosmetic Names" để lấy đúng tên skin/charm/wrap.
-- Mẫu:
-- BUILTIN_PACKS["Tên Pack"] = {
--     ["Tên vũ khí"] = {Skin = {name = "Tên skin"}, Charm = {name = "Tên charm"}, Wrap = {name = "Tên wrap"}},
-- }
local BUILTIN_PACKS = {}

Custom.packOptions = {{name = "(no packs)", placeholder = true}}

do
    local HttpService = game:GetService("HttpService")
    local PACK_FILE = "KhangHub/skinpacks.json"
    local PACK_PREFIX = "KHANGPACK1:"
    local packs = {}

    local function notify(text, duration)
        showNotification("Skin Packs", text, duration or 4)
    end

    local function trim(text)
        return (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
    end

    local function ensureFolder()
        if makefolder and isfolder and not isfolder("KhangHub") then pcall(makefolder, "KhangHub") end
    end

    local function loadPacks()
        packs = {}
        if readfile and isfile and isfile(PACK_FILE) then
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(PACK_FILE)) end)
            if ok and type(data) == "table" then packs = data end
        end
    end

    local function savePacks()
        if not writefile then return false end
        ensureFolder()
        return (pcall(function() writefile(PACK_FILE, HttpService:JSONEncode(packs)) end))
    end

    local function getPack(name)
        return packs[name] or BUILTIN_PACKS[name]
    end

    function Custom.selectedPackName()
        local option = Custom.packOptions[Features.SkinPackIndex]
        if option and not option.placeholder then return option.name end
        return nil
    end

    function Custom.refreshPackOptions()
        local set = {}
        for name in pairs(BUILTIN_PACKS) do set[name] = true end
        for name in pairs(packs) do set[name] = true end
        local names = {}
        for name in pairs(set) do table.insert(names, name) end
        table.sort(names)

        for i = #Custom.packOptions, 1, -1 do table.remove(Custom.packOptions, i) end
        if #names == 0 then
            table.insert(Custom.packOptions, {name = "(no packs)", placeholder = true})
        else
            for _, name in ipairs(names) do table.insert(Custom.packOptions, {name = name}) end
        end

        local index = 1
        for i, option in ipairs(Custom.packOptions) do
            if option.name == Features.SkinPackSelected then index = i break end
        end
        Features.SkinPackIndex = index
        local option = Custom.packOptions[index]
        if option and not option.placeholder then Features.SkinPackSelected = option.name end

        if Custom.syncUI then Custom.syncUI() end
    end

    function Custom.onPackIndex(index)
        local option = Custom.packOptions[index]
        if option and not option.placeholder then Features.SkinPackSelected = option.name end
    end

    function Custom.nextPack()
        local index = (Features.SkinPackIndex % #Custom.packOptions) + 1
        Features.SkinPackIndex = index
        Custom.onPackIndex(index)
        return Custom.packOptions[index].name
    end

    function Custom.savePack()
        if not Custom.skinGetEquipped then notify("Skin Changer chưa sẵn sàng, đợi vài giây") return end
        local data = Custom.skinGetEquipped()
        if next(data) == nil then notify("Chưa trang bị skin nào để lưu") return end

        local name = trim(Features.SkinPackName)
        if name == "" then
            local count = 0
            for _ in pairs(packs) do count += 1 end
            name = "Pack " .. (count + 1)
        end
        if BUILTIN_PACKS[name] then name = name .. " (user)" end

        packs[name] = data
        local saved = savePacks()
        Features.SkinPackSelected = name
        Custom.refreshPackOptions()
        notify(saved and ("Đã lưu pack '" .. name .. "'") or ("Đã lưu pack '" .. name .. "' (chỉ trong phiên này, thiếu writefile)"), 5)
    end

    function Custom.applyPack(silent)
        local name = Custom.selectedPackName()
        local pack = name and getPack(name)
        if not pack then
            if not silent then notify("Chưa chọn pack nào") end
            return false
        end
        if not Custom.skinApply then
            if not silent then notify("Skin Changer chưa sẵn sàng, đợi vài giây") end
            return false
        end
        if not Features.SkinChanger then
            if not silent then notify("Hãy bật Skin Changer trước") end
            return false
        end
        local applied, missing = Custom.skinApply(pack)
        notify(string.format("Đã áp dụng '%s': %d mục, thiếu %d", name, applied, missing), 5)
        return true
    end

    function Custom.deletePack()
        local name = Custom.selectedPackName()
        if not name then notify("Chưa chọn pack nào") return end
        if not packs[name] then notify("Pack dựng sẵn không xóa được") return end
        packs[name] = nil
        savePacks()
        Custom.refreshPackOptions()
        notify("Đã xóa pack '" .. name .. "'")
    end

    function Custom.exportPack()
        local name = Custom.selectedPackName()
        local pack = name and getPack(name)
        if not pack then notify("Chưa chọn pack nào") return end

        local payload = PACK_PREFIX .. HttpService:JSONEncode({name = name, data = pack})
        local clip = setclipboard or toclipboard
        if clip and pcall(clip, payload) then
            notify("Đã copy pack '" .. name .. "' vào clipboard", 5)
            return
        end

        if writefile then
            ensureFolder()
            local fileName = "KhangHub/export_" .. name:gsub("[^%w_%-]", "_") .. ".txt"
            if pcall(function() writefile(fileName, payload) end) then
                notify("Executor không có clipboard, đã ghi file: " .. fileName, 6)
                return
            end
        end
        notify("Không xuất được pack (thiếu clipboard/writefile)", 5)
    end

    function Custom.importPackString(text)
        text = trim(text)
        if text:sub(1, #PACK_PREFIX) ~= PACK_PREFIX then
            notify("Chuỗi pack không hợp lệ (phải bắt đầu bằng KHANGPACK1:)", 5)
            return false
        end
        local ok, decoded = pcall(function() return HttpService:JSONDecode(text:sub(#PACK_PREFIX + 1)) end)
        if not ok or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
            notify("Không đọc được nội dung pack", 5)
            return false
        end

        local name = trim(decoded.name)
        if name == "" then name = "Imported" end
        if BUILTIN_PACKS[name] then name = name .. " (user)" end
        packs[name] = decoded.data
        savePacks()
        Features.SkinPackSelected = name
        Custom.refreshPackOptions()
        notify("Đã nhập pack '" .. name .. "'", 5)
        return true
    end

    function Custom.importPackFromTextbox()
        Custom.importPackString(Features.SkinPackImport)
    end

    function Custom.importPackFromFile()
        local path = "KhangHub/import.txt"
        if not (readfile and isfile and isfile(path)) then
            notify("Không thấy file " .. path .. " (dán chuỗi pack vào file đó rồi bấm lại)", 6)
            return
        end
        Custom.importPackString(readfile(path))
    end

    function Custom.dumpCosmetics()
        if not Custom.skinDump then notify("Skin Changer chưa sẵn sàng, đợi vài giây") return end
        local count = Custom.skinDump()
        notify("Đã ghi " .. count .. " cosmetic vào KhangHub/cosmetics.txt", 6)
    end

    loadPacks()
    Custom.refreshPackOptions()

    -- Tự áp dụng pack đã chọn khi vào game (nếu bật)
    task.spawn(function()
        for _ = 1, 60 do
            if Custom.skinApply or khangUnloaded then break end
            task.wait(0.5)
        end
        task.wait(1)
        if not khangUnloaded and Features.SkinPackAuto and Features.SkinChanger then
            Custom.applyPack(true)
        end
    end)
end

