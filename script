    local function triggerModule(mod, btn)
        if mod.key then
            setFeature(mod.key, not Features[mod.key])
        elseif mod.action then
            mod.action(btn)
        end
    end

    local function createModule(parent, mod, order)
        table.insert(allModules, mod)

        local Container = new("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder = order,
        }, parent)
        new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, Container)

        local Btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = COLORS.accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = mod.name,
            TextColor3 = mod.color or COLORS.text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            AutoButtonColor = false,
            LayoutOrder = 0,
        }, Container)
        track(Btn, "BackgroundColor3", "accent")

        local hasSettings = mod.key ~= nil or mod.settings ~= nil
        local Arrow
        if hasSettings then
            Arrow = new("TextLabel", {
                Size = UDim2.new(0, 16, 1, 0),
                Position = UDim2.new(1, -18, 0, 0),
                BackgroundTransparency = 1,
                Text = "+",
                TextColor3 = COLORS.sub,
                TextSize = 13,
                Font = Enum.Font.Gotham,
            }, Btn)
        end

        if mod.key then
            local function visual()
                Btn.BackgroundTransparency = Features[mod.key] and 0 or 1
            end
            addRefresher(mod.key, visual)
            visual()
        end

        Btn.MouseButton1Click:Connect(function()
            triggerModule(mod, Btn)
        end)

        if hasSettings then
            local Settings = new("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = COLORS.settings,
                BorderSizePixel = 0,
                Visible = false,
                LayoutOrder = 1,
            }, Container)
            track(Settings, "BackgroundColor3", "settings")
            new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, Settings)

            local index = 0
            for _, st in ipairs(mod.settings or {}) do
                index += 1
                if st.type == "slider" then
                    createSlider(Settings, st, index)
                elseif st.type == "cycle" then
                    createCycle(Settings, st, index)
                elseif st.type == "button" then
                    createButtonSetting(Settings, st, index)
                elseif st.type == "textbox" then
                    createTextBox(Settings, st, index)
                else
                    createToggleSetting(Settings, st, index)
                end
            end

            -- Dòng gán phím
            if mod.key then
            index += 1
            local BindBtn = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundTransparency = 1,
                Text = "Bind: None",
                TextColor3 = COLORS.sub,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                AutoButtonColor = false,
                LayoutOrder = index,
            }, Settings)
            mod.bindButton = BindBtn

            BindBtn.MouseButton1Click:Connect(function()
                listening = mod
                BindBtn.Text = "Bind: press a key..."
            end)
            end

            local function toggleSettings()
                Settings.Visible = not Settings.Visible
                Arrow.Text = Settings.Visible and "-" or "+"
            end
            Btn.MouseButton2Click:Connect(toggleSettings)
            if not mod.key then Btn.MouseButton1Click:Connect(toggleSettings) end
        end
    end

