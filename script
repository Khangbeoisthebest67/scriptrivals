do
    local field = Custom.skyField
    local skyActive = false
    local lastSkySig = nil
    local skyBackup, storedObjects = nil, {}
    local inst = {}
    local rainPart = nil
    local rainEmitter = nil

    local function make(class, name, parent)
        local obj = Instance.new(class)
        obj.Name = name
        obj.Parent = parent
        return obj
    end

    -- Mưa mã xanh kiểu Matrix: hạt rơi từ trên cao, luôn bám theo camera
    local function ensureRain()
        if rainPart and rainPart.Parent then return end
        rainPart = Instance.new("Part")
        rainPart.Name = "KhangMatrixRain"
        rainPart.Anchored = true
        rainPart.CanCollide = false
        rainPart.CanQuery = false
        rainPart.CanTouch = false
        rainPart.CastShadow = false
        rainPart.Transparency = 1
        rainPart.Size = Vector3.new(420, 1, 420)

        local emitter = Instance.new("ParticleEmitter")
        emitter.Rate = 900
        emitter.Lifetime = NumberRange.new(5, 7)
        emitter.Speed = NumberRange.new(45, 70)
        emitter.EmissionDirection = Enum.NormalId.Bottom
        emitter.SpreadAngle = Vector2.new(0, 0)
        emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
        emitter.Size = NumberSequence.new(1.4)
        emitter.LightEmission = 1
        emitter.LightInfluence = 0
        emitter.Color = ColorSequence.new(Color3.fromRGB(170, 255, 190), Color3.fromRGB(0, 200, 60))
        emitter.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.1, 0.1),
            NumberSequenceKeypoint.new(0.8, 0.3),
            NumberSequenceKeypoint.new(1, 1),
        })
        emitter.Parent = rainPart
        rainEmitter = emitter
        rainPart.Parent = Workspace
    end

    local function removeRain()
        if rainPart then
            rainPart:Destroy()
            rainPart = nil
            rainEmitter = nil
        end
    end

    local function applySky()
        local preset = SKY_PRESETS[Features.SkyPreset] or SKY_PRESETS[1]
        local rainbow = Features.SkyRainbow
        local hue = (tick() % 6) / 6
        -- Chất lượng shader: 1 = nhẹ (không mây/tia nắng/DoF), 2 = có mây, 3 = đầy đủ. Low Lag Mode ép về 1.
        local quality = Features.LowLag and 1 or Features.SkyQuality

        Lighting.ClockTime = Features.SkyTime
        Lighting.ColorShift_Top = rainbow and Color3.fromHSV(hue, 0.6, 1) or preset.top
        pcall(function() Lighting.ExposureCompensation = Features.SkyExposure / 10 end)

        inst.sky.StarCount = Features.SkyStars

        local atmo = inst.atmo
        atmo.Density = Features.SkyDensity / 100
        atmo.Offset = 0.25
        atmo.Haze = preset.haze
        atmo.Glare = preset.glare
        atmo.Decay = preset.atmoDecay
        atmo.Color = rainbow and Color3.fromHSV(hue, 0.55, 1) or preset.atmoColor

        local clouds = inst.clouds
        clouds.Enabled = quality >= 2 and Features.SkyClouds > 0
        clouds.Cover = Features.SkyClouds / 100
        clouds.Density = 0.6
        clouds.Color = rainbow and Color3.fromHSV((hue + 0.3) % 1, 0.35, 1) or field(preset, "cloudColor")

        local bloom = inst.bloom
        bloom.Enabled = Features.SkyBloom > 0
        bloom.Intensity = Features.SkyBloom / 40
        bloom.Size = 28
        bloom.Threshold = 0.85

        local cc = inst.cc
        cc.Saturation = Features.SkySaturation / 100
        cc.Contrast = Features.SkyContrast / 100
        cc.TintColor = field(preset, "tint")

        local rays = inst.rays
        rays.Enabled = quality >= 3 and Features.SkySunRays > 0
        rays.Intensity = Features.SkySunRays / 100 * 0.5
        rays.Spread = 0.8

        local dofAmount = field(preset, "dof")
        local dof = inst.dof
        dof.Enabled = quality >= 3 and dofAmount > 0
        dof.FarIntensity = dofAmount
        dof.FocusDistance = 60
        dof.InFocusRadius = 80
        dof.NearIntensity = 0

        if Features.SkyMatrix then
            ensureRain()
            if rainEmitter then rainEmitter.Rate = quality == 1 and 250 or (quality == 2 and 500 or 900) end
            rainPart.CFrame = CFrame.new(Camera.CFrame.Position + Vector3.new(0, 110, 0))
        else
            removeRain()
        end
    end

    function enableSky()
        if skyActive then return end
        skyActive = true
        skyBackup = {
            ClockTime = Lighting.ClockTime,
            ColorShift_Top = Lighting.ColorShift_Top,
            ColorShift_Bottom = Lighting.ColorShift_Bottom,
            ExposureCompensation = Lighting.ExposureCompensation,
        }

        -- Cất sky / atmosphere / clouds gốc của game để dùng cái của mình
        storedObjects = {}
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("Sky") or child:IsA("Atmosphere") then
                table.insert(storedObjects, {obj = child, parent = Lighting})
                child.Parent = nil
            end
        end
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            for _, child in ipairs(terrain:GetChildren()) do
                if child:IsA("Clouds") then
                    table.insert(storedObjects, {obj = child, parent = terrain})
                    child.Parent = nil
                end
            end
        end

        inst.sky = make("Sky", "KhangSky", Lighting)
        inst.sky.CelestialBodiesShown = true
        inst.atmo = make("Atmosphere", "KhangAtmosphere", Lighting)
        inst.clouds = make("Clouds", "KhangClouds", terrain) -- cần nằm trong Terrain
        inst.bloom = make("BloomEffect", "KhangBloom", Lighting)
        inst.cc = make("ColorCorrectionEffect", "KhangColor", Lighting)
        inst.rays = make("SunRaysEffect", "KhangRays", Lighting)
        inst.dof = make("DepthOfFieldEffect", "KhangDof", Lighting)

        lastSkySig = nil
        pcall(applySky)
    end

    function disableSky()
        if not skyActive then return end
        skyActive = false

        removeRain()
        for key, obj in pairs(inst) do
            pcall(function() obj:Destroy() end)
            inst[key] = nil
        end
        for _, item in ipairs(storedObjects) do
            pcall(function() item.obj.Parent = item.parent end)
        end
        storedObjects = {}

        if skyBackup then
            for key, value in pairs(skyBackup) do
                pcall(function() Lighting[key] = value end)
            end
            skyBackup = nil
        end
    end

    local skyTimer = 0
    RunService.RenderStepped:Connect(function(dt)
        if not skyActive or khangUnloaded then return end

        -- Mỗi frame chỉ giữ giờ và mưa Matrix; phần còn lại áp dụng ~4 lần/giây (trừ khi Rainbow)
        if Lighting.ClockTime ~= Features.SkyTime then Lighting.ClockTime = Features.SkyTime end
        if Features.SkyMatrix and rainPart then
            rainPart.CFrame = CFrame.new(Camera.CFrame.Position + Vector3.new(0, 110, 0))
        end

        skyTimer += dt
        if Features.SkyRainbow or skyTimer >= 0.25 then
            skyTimer = 0
            local sig = table.concat({
                Features.SkyPreset, Features.SkyTime, Features.SkyStars, Features.SkyDensity, Features.SkyClouds,
                Features.SkyBloom, Features.SkySunRays, Features.SkySaturation, Features.SkyContrast,
                Features.SkyExposure, tostring(Features.SkyMatrix), tostring(Features.LowLag), Features.SkyQuality,
            }, ",")
            if Features.SkyRainbow or sig ~= lastSkySig then
                lastSkySig = sig
                pcall(applySky)
            end
        end
    end)

    function Custom.isSkyActive()
        return skyActive
    end
end

-- ===== TARGET STRAFE + ANTI AIM =====
do
    local strafeAngle = 0
    local strafeTarget = nil
    local aaYaw, aaFlip = 0, false
    local aaActive, aaSavedAutoRotate = false, true

    local function findStrafeTarget(rootPos)
        local best, bestDist = nil, Features.StrafeRange
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and isEnemy(player) and player.Character then
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local d = (hrp.Position - rootPos).Magnitude
                    if d <= bestDist then
                        best, bestDist = hrp, d
                    end
                end
            end
        end
        return best
    end

    RunService.Heartbeat:Connect(function(dt)
        local hum, root = getHumanoid(), getRoot()
        local alive = hum and root and hum.Health > 0

        -- Target Strafe: bay vòng quanh địch gần nhất
        if Features.TargetStrafe and alive then
            local valid = strafeTarget ~= nil
                and strafeTarget.Parent ~= nil
                and (strafeTarget.Position - root.Position).Magnitude <= Features.StrafeRange
            if valid then
                local targetHum = strafeTarget.Parent:FindFirstChildOfClass("Humanoid")
                valid = targetHum ~= nil and targetHum.Health > 0
            end
            if not valid then
                strafeTarget = findStrafeTarget(root.Position)
            end

            if strafeTarget then
                strafeAngle += math.rad(Features.StrafeSpeed * 45) * dt
                local center = strafeTarget.Position
                local pos = center + Vector3.new(
                    math.cos(strafeAngle) * Features.StrafeRadius,
                    Features.StrafeY,
                    math.sin(strafeAngle) * Features.StrafeRadius
                )
                if Features.StrafeFace then
                    root.CFrame = CFrame.new(pos, Vector3.new(center.X, pos.Y, center.Z))
                else
                    root.CFrame = CFrame.new(pos) * (root.CFrame - root.CFrame.Position)
                end
                root.AssemblyLinearVelocity = Vector3.zero
            end
        else
            strafeTarget = nil
        end

        -- Anti Aim: xoay / giật hướng nhân vật
        if (Features.AntiAim or (Features.RageBot and Features.RageAntiAim)) and alive and not Custom.rageTPBusy then
            if not aaActive then
                aaActive = true
                aaSavedAutoRotate = hum.AutoRotate
            end
            hum.AutoRotate = false

            local look = Camera.CFrame.LookVector
            local camYaw = math.atan2(-look.X, -look.Z)
            local yaw
            local mode = Features.AntiAimMode
            if mode == 1 then
                aaYaw += math.rad(Features.AntiAimSpeed * 20) * dt
                yaw = aaYaw
            elseif mode == 2 then
                aaFlip = not aaFlip
                yaw = camYaw + (aaFlip and 1.5708 or -1.5708)
            elseif mode == 3 then
                yaw = camYaw + math.pi
            else
                yaw = math.rad(math.random(0, 359))
            end
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
        elseif aaActive then
            aaActive = false
            if hum then hum.AutoRotate = aaSavedAutoRotate end
        end
    end)
end

