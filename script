local function isVisible(targetPart, targetChar)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    local origin = Camera.CFrame.Position
    local result = Workspace:Raycast(origin, targetPart.Position - origin, params)
    return result == nil or result.Instance:IsDescendantOf(targetChar)
end

local function getAimbotTarget()
    local char = LocalPlayer.Character
    local localHRP = char and char:FindFirstChild("HumanoidRootPart")
    if not localHRP then return nil end

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bestDist = nil, math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and isEnemy(player) then
            local head = player.Character:FindFirstChild("Head")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if head and hrp and humanoid and humanoid.Health > 0 then
                local distance = (hrp.Position - localHRP.Position).Magnitude
                if distance <= Features.MaxDistance then
                    local aimPos = head.Position + Vector3.new(0, Features.AimOffset, 0)
                    local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
                    if onScreen then
                        local d = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if d <= Features.AimbotFOV and d < bestDist then
                            if not Features.WallCheck or isVisible(head, player.Character) then
                                bestDist = d
                                best = aimPos
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

local triggerBusy = false
local function getTriggerTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    local result = Workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * Features.MaxDistance, params)
    if not result then return nil end
    local model = result.Instance:FindFirstAncestorOfClass("Model")
    local humanoid = model and model:FindFirstChildOfClass("Humanoid")
    local player = model and Players:GetPlayerFromCharacter(model)
    if humanoid and humanoid.Health > 0 and player and isEnemy(player) then
        return player
    end
    return nil
end

local function doClick()
    if mouse1click then
        mouse1click()
    else
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2, 0, true, game, 0)
        vim:SendMouseButtonEvent(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2, 0, false, game, 0)
    end
end

RunService.RenderStepped:Connect(function()
    -- Aimbot
    AimbotCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    AimbotCircle.Radius = Features.AimbotFOV
    AimbotCircle.Visible = Features.Aimbot

    if Features.Aimbot then
        local holding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        if not Features.HoldRMB or holding then
            local targetPos = getAimbotTarget()
            if targetPos then
                local camPos = Camera.CFrame.Position
                local goal = CFrame.new(camPos, targetPos)
                local factor = math.clamp(1 - (Features.AimbotSmooth / 101), 0.01, 1)
                Camera.CFrame = Camera.CFrame:Lerp(goal, factor)
            end
        end
    end

    -- Triggerbot
    if Features.TriggerBot and not triggerBusy and getTriggerTarget() then
        triggerBusy = true
        task.spawn(function()
            local delayMs = Features.TriggerDelay
            if delayMs > 0 then task.wait(delayMs / 1000) end
            if Features.TriggerBot and getTriggerTarget() then
                doClick()
            end
            task.wait(0.08)
            triggerBusy = false
        end)
    end
end)

RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Radius = Features.FOV
    FOVCircle.Visible = Features.SilentAim
    
    if Features.SilentAim and LocalPlayer.Character then
        local target = getTargetWithLock()
        
        if target and target.Head then
            local targetPos = target.Position
            local currentCFrame = Camera.CFrame
            
            local smoothness = target.Distance < 30 and 0.35 or 0.15
            if target.Distance < 10 then
                smoothness = 0.5
            end
            
            local targetDirection = (targetPos - currentCFrame.Position).Unit
            local targetCFrame = CFrame.new(currentCFrame.Position, currentCFrame.Position + targetDirection)
            
            Camera.CFrame = currentCFrame:Lerp(targetCFrame, smoothness)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and Features.SilentAim then
        local target = getTargetWithLock()
        if target and target.Head then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            
            if ReplicatedStorage:FindFirstChild("Remotes") then
                for _, remote in pairs(ReplicatedStorage.Remotes:GetChildren()) do
                    if remote:IsA("RemoteEvent") then
                        local name = remote.Name:lower()
                        if name:match("attack") or name:match("hit") or name:match("damage") or name:match("combat") then
                            pcall(function()
                                remote:FireServer(target.Position)
                            end)
                        end
                    end
                end
            end
            
            if target.Distance < 15 then
                pcall(function()
                    local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    end
                end)
