    local list = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false,
        LayoutOrder = 1,
    }, container)
    create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, list)

    local value = o.Default or options[1]
    local obj = {}
    local optionButtons = {}

    local function visual()
        current.Text = tostring(value) .. "  ▾"
        for name, b in pairs(optionButtons) do
            b.TextColor3 = (name == value) and win.Colors.Accent or win.Colors.SubText
        end
    end

    function obj:Set(v, silent)
        if v == value then return end
        value = v
        if o.Flag then win.Flags[o.Flag] = value end
        visual()
        if o.Callback and not silent then task.spawn(o.Callback, value) end
    end
    function obj:Get() return value end

    function obj:SetOptions(newOptions)
        options = newOptions
        for _, b in pairs(optionButtons) do b:Destroy() end
