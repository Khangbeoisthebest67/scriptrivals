function Tab:AddSlider(o)
    local win = self.Window
    local min, max = o.Min or 0, o.Max or 100
    local inc = o.Increment or 1
    local row = baseRow(self, 48)
    rowLabel(win, row, o.Name or "Slider", 0.6).Position = UDim2.new(0, 12, 0, 4)
    row:FindFirstChildOfClass("TextLabel").Size = UDim2.new(0.6, -12, 0, 22)

    local valueLabel = create("TextLabel", {
        Size = UDim2.new(0.4, -12, 0, 22),
        Position = UDim2.new(0.6, 0, 0, 4),
        BackgroundTransparency = 1,
        TextColor3 = win.Colors.SubText,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)
    create("UIPadding", {PaddingRight = UDim.new(0, 12)}, valueLabel)

    local track = create("Frame", {
        Position = UDim2.new(0, 12, 0, 34),
        Size = UDim2.new(1, -24, 0, 4),
        BackgroundColor3 = win.Colors.Off,
        BorderSizePixel = 0,
    }, row)
    corner(track, 2)
    local fill = create("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = win.Colors.Accent, BorderSizePixel = 0}, track)
    corner(fill, 2)
    win:_track(fill, "BackgroundColor3", "Accent")
    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(10, 10),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, track)
    corner(knob, 5)

    local value = math.clamp(o.Default or min, min, max)
    local obj = {}

    local function visual()
        local pos = (max == min) and 0 or math.clamp((value - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, 0, 0.5, 0)
        valueLabel.Text = tostring(value) .. (o.Suffix or "")
    end

    function obj:Set(v, silent)
        v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
        if inc < 1 then v = tonumber(string.format("%.3f", v)) end
        if v == value then return end
        value = v
        if o.Flag then win.Flags[o.Flag] = value end
        visual()
        if o.Callback and not silent then task.spawn(o.Callback, value) end
    end
    function obj:Get() return value end

    local function fromInput(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        obj:Set(min + (max - min) * rel)
    end

    local hit = create("TextButton", {
        Position = UDim2.new(0, 8, 0, 26),
        Size = UDim2.new(1, -16, 0, 20),
        BackgroundTransparency = 1,
        Text = "",
    }, row)
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            win.ActiveDrag = fromInput
            fromInput(input)
        end
    end)

    win:_register(o.Flag, value, function(v) obj:Set(v) end)
    visual()
    return obj
end

