        local maxH = math.max(140, (win.Gui.AbsoluteSize.Y - 80) / (win.ScaleValue or 1))
        panel.Size = UDim2.fromOffset(190, math.min(34 + layout.AbsoluteContentSize.Y + 16, maxH))
