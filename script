-- ===== PERFORMANCE (giảm lag) =====
local boostBackup = setmetatable({}, {__mode = "k"})
local boostLighting, boostTerrain, boostEffects = nil, nil, {}
local boostConn, boostQuality = nil, nil
local boostActive, boostToken = false, 0

local function boostInstance(v)
    if v:IsA("BasePart") and not v:IsA("Terrain") then
        if boostBackup[v] == nil then
            boostBackup[v] = {Material = v.Material, Reflectance = v.Reflectance, CastShadow = v.CastShadow}
        end
        v.Material = Enum.Material.SmoothPlastic
        v.Reflectance = 0
        v.CastShadow = false
    elseif v:IsA("Decal") or v:IsA("Texture") then
        if boostBackup[v] == nil then boostBackup[v] = {Transparency = v.Transparency} end
        v.Transparency = 1
    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
        if boostBackup[v] == nil then boostBackup[v] = {Enabled = v.Enabled} end
        v.Enabled = false
    end
end

function enableBoost()
    if boostActive then return end
    boostActive = true
    boostToken += 1
    local token = boostToken

    -- Chất lượng đồ họa
    pcall(function()
        boostQuality = settings().Rendering.QualityLevel
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    -- Ánh sáng + hiệu ứng hậu kỳ
    boostLighting = {GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd}
    Lighting.GlobalShadows = false
    boostEffects = {}
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("PostEffect") then
            boostEffects[child] = child.Enabled
            child.Enabled = false
        end
    end

    -- Nước
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        boostTerrain = {
            WaterWaveSize = terrain.WaterWaveSize,
