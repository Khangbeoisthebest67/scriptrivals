    local localHRP = LocalPlayer.Character.HumanoidRootPart
    local localPos = localHRP.Position

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and isEnemy(player) then
            local head = player.Character:FindFirstChild("Head")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            
            if head and hrp and humanoid and humanoid.Health > 0 then
                local distance = (hrp.Position - localPos).Magnitude
                
                if distance <= Features.MaxDistance then
                    local aimPosition = head.Position + Vector3.new(0, Features.AimOffset, 0)
                    local screenPos, onScreen = Camera:WorldToViewportPoint(aimPosition)
                    
                    if onScreen then
                        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                        local distFromCenter = (screenPos2D - screenCenter).Magnitude
                        
                        local effectiveFOV = Features.FOV
                        if distance < 30 then
                            effectiveFOV = effectiveFOV * 2.0
                        elseif distance < 100 then
                            effectiveFOV = effectiveFOV * 1.3
                        end
                        
                        if distFromCenter <= effectiveFOV then
                            local distanceScore = distance < 50 and distance * 3 or distance * 0.5
                            local centerScore = distFromCenter * (distance < 30 and 0.3 or 1.0)
                            local score = centerScore + distanceScore
                            
                            if score < bestScore then
                                bestScore = score
                                bestTarget = {
                                    Head = head,
                                    HumanoidRootPart = hrp,
                                    Position = aimPosition,
                                    Distance = distance,
                                    Player = player
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    
    return bestTarget
end

local function getTargetWithLock()
    local currentTime = tick()
    
    if targetLock and targetLock.Head and targetLock.Head.Parent then
        local player = targetLock.Player
        if player and isEnemy(player) then
            local hrp = targetLock.HumanoidRootPart
            local humanoid = targetLock.Head.Parent:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                local distance = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                local aimPosition = targetLock.Head.Position + Vector3.new(0, Features.AimOffset, 0)
                local screenPos, onScreen = Camera:WorldToViewportPoint(aimPosition)
                
                if onScreen and distance <= Features.MaxDistance and (currentTime - lastTargetTime) < targetLockTime then
                    if lastTargetPosition then
                        targetVelocity = (aimPosition - lastTargetPosition) * 0.5
                    end
                    lastTargetPosition = aimPosition
                    lastTargetTime = currentTime
                    
                    targetLock.Position = aimPosition + (targetVelocity * 0.1)
                    targetLock.Distance = distance
                    return targetLock
                end
            end
        end
    end
    
    local newTarget = getBestTarget()
    if newTarget then
        targetLock = newTarget
        lastTargetTime = currentTime
        lastTargetPosition = newTarget.Position
        targetVelocity = Vector3.new(0, 0, 0)
    else
        targetLock = nil
        lastTargetPosition = nil
    end
    
    return targetLock
end

