do
    local Debris = game:GetService("Debris")
    local emoteTrack = nil

    local function notifyEmoteState()
        if Custom.emoteStateChanged then Custom.emoteStateChanged() end
    end

    -- ---------- Emote ----------
    function Custom.stopEmote()
        local track = emoteTrack
        emoteTrack = nil
        if track then
            pcall(function()
                track:Stop()
                track:Destroy()
            end)
        end
    end

    function Custom.playEmote()
        Custom.stopEmote()
        local hum = getHumanoid()
        if not hum then return false end

        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = hum
        end

        local entry = Custom.EMOTES[Features.EmoteIndex] or Custom.EMOTES[1]
        local rawId = entry.custom and Features.EmoteCustomId or entry.id
        local id = string.match(tostring(rawId), "%d+")
        if not id then
            warn("[Khang Hub] Emote: Animation ID không hợp lệ")
            return false
        end

        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. id
        local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
        if not ok or not track then
            warn("[Khang Hub] Emote: không tải được animation " .. id)
            return false
        end

        track.Priority = Enum.AnimationPriority.Action4
        track.Looped = Features.EmoteLoop and true or false
        track:Play()
        track:AdjustSpeed(Features.EmoteSpeed / 100)
        emoteTrack = track

        track.Stopped:Connect(function()
            if emoteTrack == track then
                emoteTrack = nil
                if Features.EmotePlay then
                    Features.EmotePlay = false
                    notifyEmoteState()
                end
            end
        end)
        return true
    end

    function Custom.onEmoteToggle(state)
        if state then
            if not Custom.playEmote() then
                Features.EmotePlay = false
                notifyEmoteState()
            end
        else
            Custom.stopEmote()
        end
    end

    function Custom.nextEmote()
        Features.EmoteIndex = (Features.EmoteIndex % #Custom.EMOTES) + 1
        return Custom.EMOTES[Features.EmoteIndex].name
