    local state = o.Default and true or false
    local obj = {}

    local function visual(animate)
        local info = TweenInfo.new(animate and 0.15 or 0)
        TS:Create(pill, info, {BackgroundColor3 = state and win.Colors.Accent or win.Colors.Off}):Play()
        TS:Create(dot, info, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}):Play()
