    local uiSaveToken = 0
    local function saveUI()
        if not writefile then return end
        uiSaveToken += 1
        local token = uiSaveToken
        task.delay(0.5, function()
            if token ~= uiSaveToken then return end
            pcall(function()
                local data = {}
                for key in pairs(UI_DEFAULTS) do data[key] = Features[key] end
                writefile(UI_FILE, HttpService:JSONEncode(data))
            end)
        end)
    end

    local function new(class, props, parent)
        local obj = Instance.new(class)
        for key, value in pairs(props) do obj[key] = value end
        obj.Parent = parent
        return obj
    end

