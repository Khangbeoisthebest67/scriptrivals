        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local startMouse, startPos = input.Position, panel.Position
            win.ActiveDrag = function(move)
                local d = move.Position - startMouse
                local k = 1 / (win.ScaleValue or 1)
                panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X * k, startPos.Y.Scale, startPos.Y.Offset + d.Y * k)
            end
        end
    end)
