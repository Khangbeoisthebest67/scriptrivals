function unloadHub()
    if khangUnloaded then return end
    khangUnloaded = true

    -- Lưu cấu hình TRƯỚC khi tắt toàn bộ tính năng bên dưới
    pcall(function()
        if Features.ConfigAutoSave then Custom.saveConfig(true) end
    end)

    -- Tắt mọi tính năng để các vòng lặp tự khôi phục trạng thái (speed, fly, fullbright, FOV, camera...)
    for key, value in pairs(Features) do
        if type(value) == "boolean" then Features[key] = false end
    end
    for key in pairs(Keybinds) do Keybinds[key] = nil end

    pcall(disableTexturePack)
    pcall(disableDarkener)
    pcall(function() if Custom.mapTexDisable then Custom.mapTexDisable() end end)
    pcall(disableBoost)
    pcall(disableSky)
    pcall(function() Custom.stopEmote() end)

    task.wait(0.3)

    for player, hl in pairs(chams) do
        pcall(function() hl:Destroy() end)
        chams[player] = nil
    end
    for player in pairs(espObjects) do
        removeESP(player)
    end
    pcall(function() FOVCircle.Visible = false end)
    pcall(function() AimbotCircle.Visible = false end)
    pcall(function() fpsText.Visible = false end)
    pcall(function() RunService:UnbindFromRenderStep("KhangThirdPerson") end)
    pcall(stopFly)

    pcall(function() ScreenGui:Destroy() end)
    pcall(function() collectgarbage("collect") end)
    pcall(function() khangEnv.KhangHubUnload = nil end)
end

