        ThemeIndex = true, BgIndex = true, PanelScale = true, PanelTransparency = true,
        PanelCorner = true, PanelStyle = true, EmotePlay = true,
        SkinPackIndex = true, SkinPackName = true, SkinPackImport = true, PerfLog = true,
    }
    local lastSaved = nil

    local function snapshot()
        local features = {}
        for key, value in pairs(Features) do
            local t = type(value)
            if not SKIP[key] and (t == "boolean" or t == "number" or t == "string") then
                features[key] = value
            end
        end
        local binds = Custom.getBinds and Custom.getBinds() or {}
        return {version = 1, features = features, binds = binds}
    end

    local function encodeSnapshot()
        local ok, encoded = pcall(function() return HttpService:JSONEncode(snapshot()) end)
        return ok and encoded or nil
    end

    local function readConfig()
        if not (readfile and isfile and isfile(CONFIG_FILE)) then return nil end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if ok and type(data) == "table" then return data end
        return nil
    end

    -- ---------- Lưu ----------
    function Custom.saveConfig(force)
        if not writefile then return false end
        local encoded = encodeSnapshot()
        if not encoded then return false end
        if not force and encoded == lastSaved then return true end
        local wrote = pcall(function()
            if makefolder and isfolder and not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
            writefile(CONFIG_FILE, encoded)
        end)
        if wrote then lastSaved = encoded end
        return wrote
    end

    function Custom.saveNow()
        local ok = Custom.saveConfig(true)
        showNotification("Config", ok and "Đã lưu cấu hình" or "Không lưu được (thiếu writefile?)", 4)
    end

    -- ---------- Nạp ----------
    function Custom.loadConfig()
        local data = readConfig()
        if not data or type(data.features) ~= "table" then
            showNotification("Config", "Chưa có cấu hình đã lưu", 4)
            return false
        end

        for key, value in pairs(data.features) do
            if not SKIP[key] and Features[key] ~= nil and type(Features[key]) == type(value) then
                Features[key] = value
            end
        end
        if type(data.binds) == "table" and Custom.setBinds then
            Custom.setBinds(data.binds)
        end

        -- Các tính năng cần hàm khởi động / dọn dẹp riêng
        if Features.Darkness then pcall(setDarkness, Features.Darkness) end
        pcall(Features.FPSBoost and enableBoost or disableBoost)
        pcall(Features.TexturePack and enableTexturePack or disableTexturePack)
        pcall(Features.MapDarkener and enableDarkener or disableDarkener)
        pcall(Features.SkyChanger and enableSky or disableSky)

        if Features.SkinChanger and not skinInitialized then
            skinInitialized = true
            task.spawn(function()
                local ok, err = pcall(InitSkinChanger)
                if not ok then warn("[Khang Hub] Skin Changer error: " .. tostring(err)) end
            end)
        end
        if Custom.refreshPackOptions then Custom.refreshPackOptions() end
        if Custom.syncUI then Custom.syncUI() end
        lastSaved = encodeSnapshot()
        return true
    end

    function Custom.deleteConfig()
        pcall(function()
            if delfile and isfile and isfile(CONFIG_FILE) then delfile(CONFIG_FILE) end
        end)
        lastSaved = encodeSnapshot()
        showNotification("Config", "Đã xóa cấu hình đã lưu", 4)
    end

    -- ---------- Auto Execute ----------
    local function buildLoader()
        local source = tostring(Features.AutoExecSource or "")
        if source == "" then source = "khang_hub.lua" end
        local isUrl = source:lower():match("^https?://") ~= nil
        local loadLine = isUrl
            and string.format("loadstring(game:HttpGet(%q))()", source)
            or string.format("loadstring(readfile(%q))()", source)

        if writefile and readfile then
            -- Chỉ chạy nếu cấu hình đã lưu còn bật Auto Execute (tắt nút là loader tự bỏ qua)
            return table.concat({
                'local ok, cfg = pcall(function()',
                '    return game:GetService("HttpService"):JSONDecode(readfile("KhangHub/config.json"))',
                'end)',
                'if ok and cfg and cfg.features and cfg.features.AutoExec then',
                '    ' .. loadLine,
                'end',
            }, "\n")
        end
        return loadLine
    end

    function Custom.queueAutoExec(silent)
        local queue = queue_on_teleport or queueonteleport
            or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
        if not queue then
            if not silent then
                showNotification("Auto Execute", "Executor không hỗ trợ queue_on_teleport", 5)
            end
            return false
        end
        local ok = pcall(queue, buildLoader())
        if not silent then
            showNotification("Auto Execute", ok and "Đã bật: script chạy lại khi đổi server" or "Không queue được", 5)
        end
        return ok
    end

    function Custom.onAutoExec(state)
        Custom.saveConfig(true) -- loader đọc cờ AutoExec từ file cấu hình
        if state then Custom.queueAutoExec() end
    end

    function Custom.installAutoexecFile()
        if not writefile then
            showNotification("Auto Execute", "Executor thiếu writefile", 5)
            return
        end
        Custom.saveConfig(true)
        local loader = buildLoader()
        local written
        for _, path in ipairs({"autoexec/KhangHub.lua", "../autoexec/KhangHub.lua"}) do
            local ok = pcall(function() writefile(path, loader) end)
            if ok and (not isfile or isfile(path)) then
                written = path
                break
            end
        end
        showNotification("Auto Execute",
            written and ("Đã ghi loader: " .. written) or "Không ghi được vào autoexec",
            6)
    end

    -- ---------- Khởi động: nạp cấu hình, bật lại auto execute, tự lưu ----------
    local startData = readConfig()
    if startData and type(startData.features) == "table" and startData.features.ConfigAutoLoad ~= false then
        pcall(Custom.loadConfig)
    end
    lastSaved = encodeSnapshot()
    if Features.AutoExec then Custom.queueAutoExec(true) end

    task.spawn(function()
        while not khangUnloaded do
            task.wait(5)
            if Features.ConfigAutoSave and not khangUnloaded then
                Custom.saveConfig(false)
            end
        end
    end)

    -- Chạy lại script (hoặc autoexec chạy trùng) sẽ tự gỡ bản cũ
    local env = (getgenv and getgenv()) or _G
    env.KhangHubUnload = function() unloadHub() end
end)()

-- ===== ĐỒNG BỘ TRẠNG THÁI HIỆU ỨNG =====
-- Nếu vì lý do nào đó nút đã tắt mà hiệu ứng vẫn chạy (hoặc ngược lại), tự đưa về đúng trạng thái của nút.
task.spawn(function()
    local function reconcile(wanted, active, enable, disable)
        if wanted and not active then
            pcall(enable)
        elseif not wanted and active then
            pcall(disable)
        end
    end

    local lastTexSig, lastMapSig = nil, nil
    while not khangUnloaded do
        task.wait(0.5)
        if khangUnloaded then break end
        reconcile(Features.FPSBoost and true or false, boostActive, enableBoost, disableBoost)
        if Custom.isDarkenerActive then
            reconcile(Features.MapDarkener and true or false, Custom.isDarkenerActive(), enableDarkener, disableDarkener)
        end
        if Custom.isTextureActive then
            reconcile(Features.TexturePack and true or false, Custom.isTextureActive(), enableTexturePack, disableTexturePack)
        end
        if Custom.isSkyActive then
            reconcile(Features.SkyChanger and true or false, Custom.isSkyActive(), enableSky, disableSky)
        end
        if Custom.isMapTexActive then
            reconcile(Features.MapTexture and true or false, Custom.isMapTexActive(), Custom.mapTexEnable, Custom.mapTexDisable)
        end

        -- Bật / tắt nhóm texture hoặc đổi nguồn / chất liệu map => áp dụng lại (dùng chung cho mọi kiểu UI)
        local texSig = table.concat({
            tostring(Features.TexUI), tostring(Features.TexRanks), tostring(Features.TexKillSounds),
            tostring(Features.TexMatchSounds), tostring(Features.TexMoveSounds), tostring(Features.TexMenuSounds),
            tostring(Features.TexOtherSounds),
        }, ",")
        if texSig ~= lastTexSig then
            lastTexSig = texSig
            if Custom.refreshTexturePack then pcall(Custom.refreshTexturePack) end
        end
        local mapSig = tostring(Features.MapTextureSource) .. "|" .. tostring(Features.MapMaterialIndex)
        if mapSig ~= lastMapSig then
            lastMapSig = mapSig
            if Custom.mapTexRefresh then pcall(Custom.mapTexRefresh) end
        end
    end
end)

-- ===== PROFILER (Perf Log) =====
-- Bật "Perf Log (F9)" trong menu: mỗi 3 giây console in ra các callback tốn thời gian nhất (kèm số dòng code).
task.spawn(function()
    local perf = RunService.KhangPerf
    local ticks = 0
    while not khangUnloaded do
        task.wait(1)
        perf.enabled = Features.PerfLog and true or false
        if perf.enabled then
            ticks += 1
            if ticks >= 3 then
                ticks = 0
                local rows = {}
                for label, st in pairs(perf.stats) do
                    rows[#rows + 1] = {label = label, total = st.total * 1000, avg = st.total / st.count * 1000, max = st.max * 1000, calls = st.count}
                end
                perf.stats = {}
                table.sort(rows, function(a, b) return a.total > b.total end)
                print("[Khang Perf] callback tốn nhiều nhất trong 3 giây (dòng code | tổng ms | trung bình ms | max ms | số lần)")
                for i = 1, math.min(8, #rows) do
                    local row = rows[i]
                    print(string.format("  dòng %s | %.1f | %.3f | %.2f | %d", row.label, row.total, row.avg, row.max, row.calls))
                end
            end
        else
            ticks = 0
        end
    end
end)

-- ===== CHẨN ĐOÁN CRASH =====
-- Mỗi khi danh sách tính năng đang bật thay đổi, ghi ra KhangHub/enabled_features.txt.
-- Nếu game bị crash, mở file này để biết lúc đó đang bật những tính năng nào.
task.spawn(function()
    local last = ""
    while not khangUnloaded do
        task.wait(1)
        if writefile then
            local on = {}
            for key, value in pairs(Features) do
                if value == true then on[#on + 1] = key end
            end
            table.sort(on)
            local text = table.concat(on, "\n")
            if text ~= last then
                last = text
                pcall(function()
                    if makefolder and isfolder and not isfolder("KhangHub") then makefolder("KhangHub") end
                    writefile("KhangHub/enabled_features.txt", os.date("%H:%M:%S") .. "\n" .. text)
                end)
            end
        end
    end
end)
