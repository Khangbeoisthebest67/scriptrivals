function Lib.new(opts)
    opts = opts or {}
    local self = setmetatable({}, Lib)
    self.Flags = {}
    self.Setters = {}
    self.Tabs = {}
    self.Connections = {}
    self.Themed = {}
    self.Colors = {}
    for k, v in pairs(BASE) do self.Colors[k] = v end
    for k, v in pairs(opts.Colors or {}) do self.Colors[k] = v end
    self.Colors.Accent = opts.Accent or self.Colors.Accent or Lib.Themes.Blue.Accent
    self.ScaleValue = 1
    if opts.ToggleKey == nil then
        self.ToggleKey = Enum.KeyCode.RightShift
    else
        self.ToggleKey = opts.ToggleKey -- false = không tự ẩn/hiện bằng phím
    end
    self.ConfigFolder = opts.ConfigFolder or "KhangUI"
    self.Destroyed = false
    self.ActiveDrag = nil
    self.Listening = nil -- keybind đang chờ phím

    local size = opts.Size or Vector2.new(540, 380)

    self.Gui = create("ScreenGui", {
        Name = opts.Name or "KhangUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 999,
        IgnoreGuiInset = true,
    })
    self.Gui.Parent = getGuiParent()

    self.Main = create("Frame", {
        Name = "Main",
        Size = UDim2.fromOffset(size.X, size.Y),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = self.Colors.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, self.Gui)
    corner(self.Main, 10)
    self:_track(self.Main, "BackgroundColor3", "Background")
    self.MainScale = create("UIScale", {}, self.Main)

    -- Title bar
    local titleBar = create("Frame", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = self.Colors.Sidebar,
        BorderSizePixel = 0,
    }, self.Main)
    self:_track(titleBar, "BackgroundColor3", "Sidebar")

    local titleLabel = create("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = opts.Title or "KhangUI",
        TextColor3 = self.Colors.Accent,
        TextSize = 16,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, titleBar)
    self:_track(titleLabel, "TextColor3", "Accent")

    local closeBtn = create("TextButton", {
        Size = UDim2.fromOffset(26, 26),
        Position = UDim2.new(1, -32, 0, 6),
        BackgroundColor3 = Color3.fromRGB(220, 70, 70),
        Text = "X",
        TextColor3 = Color3.new(1, 1, 1),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = true,
    }, titleBar)
    corner(closeBtn, 6)
    closeBtn.MouseButton1Click:Connect(function() self:SetVisible(false) end)

    -- Kéo cửa sổ
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local startMouse, startPos = input.Position, self.Main.Position
            self.ActiveDrag = function(move)
                local d = move.Position - startMouse
                local k = 1 / (self.ScaleValue or 1)
                self.Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X * k, startPos.Y.Scale, startPos.Y.Offset + d.Y * k)
            end
        end
    end)

    -- Sidebar + vùng nội dung
    self.Sidebar = create("ScrollingFrame", {
        Position = UDim2.new(0, 0, 0, 38),
        Size = UDim2.new(0, 130, 1, -38),
        BackgroundColor3 = self.Colors.Sidebar,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
    }, self.Main)
    self:_track(self.Sidebar, "BackgroundColor3", "Sidebar")
    self.SideLayout = create("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, self.Sidebar)
    create("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, self.Sidebar)

    self.Pages = create("Frame", {
        Position = UDim2.new(0, 130, 0, 38),
        Size = UDim2.new(1, -130, 1, -38),
        BackgroundTransparency = 1,
    }, self.Main)

    -- Style 3 (Click GUI): mỗi tab là một panel nổi
    self.Panels = create("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1}, self.Gui)
    self.PanelsScale = create("UIScale", {}, self.Panels)

    -- Nút đổi nhanh giữa 3 kiểu giao diện
    self.StyleBtn = create("TextButton", {
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 6),
        Size = UDim2.fromOffset(190, 26),
        BackgroundColor3 = self.Colors.Sidebar,
        BorderSizePixel = 0,
        TextColor3 = self.Colors.Text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        ZIndex = 50,
    }, self.Gui)
    corner(self.StyleBtn, 8)
    self:_track(self.StyleBtn, "BackgroundColor3", "Sidebar")
    self.StyleBtn.MouseButton1Click:Connect(function()
        self:SetStyle((self.Style % 3) + 1)
    end)
    self.HideStyleBtn = opts.HideStyleButton and true or false
    self.Shown = true

    -- Input toàn cục
    self:_connect(UIS.InputChanged, function(input)
        if self.ActiveDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            self.ActiveDrag(input)
        end
    end)
    self:_connect(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            self.ActiveDrag = nil
        end
    end)
    self:_connect(UIS.InputBegan, function(input, processed)
        if self.Destroyed then return end
        if self.Listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                local cb = self.Listening
                self.Listening = nil
                cb(input.KeyCode)
            end
            return
        end
        if processed then return end
        if self.ToggleKey and input.KeyCode == self.ToggleKey then
            self:SetVisible(not self.Shown)
            return
        end
        for _, bind in ipairs(self.Binds or {}) do
            if bind.key and input.KeyCode == bind.key then
                task.spawn(bind.fire)
            end
        end
    end)
    self.Binds = {}

    -- Container thông báo
    self.NotifyHolder = create("Frame", {
        Size = UDim2.new(0, 260, 1, -20),
        Position = UDim2.new(1, -270, 0, 10),
        BackgroundTransparency = 1,
    }, self.Gui)
    create("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.NotifyHolder)

    self.Style = 1
    self:SetStyle(opts.Style or 1)

    return self
end

-- ---------- Nội bộ ----------
function Lib:_connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(self.Connections, c)
    return c
end

function Lib:_track(obj, prop, colorKey)
    table.insert(self.Themed, {obj = obj, prop = prop, key = colorKey})
    return obj
end

function Lib:_register(flag, default, setter)
    if not flag then return end
    self.Flags[flag] = default
    self.Setters[flag] = setter
end

-- ---------- API cửa sổ ----------
function Lib:_updateVisible()
    local shown = self.Shown
    self.Main.Visible = shown and self.Style ~= 3
    self.Panels.Visible = shown and self.Style == 3
    self.StyleBtn.Visible = shown and not self.HideStyleBtn
end

function Lib:SetVisible(state)
    self.Shown = state and true or false
    self:_updateVisible()
end

function Lib:SetAccent(color)
    if type(color) == "string" then
        local t = Lib.Themes[color]
        if not t then return end
        color = t.Accent
    end
    self.Colors.Accent = color
    for _, item in ipairs(self.Themed) do
        pcall(function() item.obj[item.prop] = self.Colors[item.key] end)
    end
    for _, fn in ipairs(self.Refreshers or {}) do pcall(fn) end
end

function Lib:SetScale(scale)
    scale = math.clamp(scale, 0.4, 2.5)
    self.ScaleValue = scale
    self.MainScale.Scale = scale
    self.PanelsScale.Scale = scale
    for _, t in ipairs(self.Tabs) do
        if t.Resize then t.Resize() end
    end
end

function Lib:SetColors(tbl)
    for k, v in pairs(tbl) do self.Colors[k] = v end
    for _, item in ipairs(self.Themed) do
        pcall(function() item.obj[item.prop] = self.Colors[item.key] end)
    end
    for _, fn in ipairs(self.Refreshers or {}) do pcall(fn) end
end

function Lib:Notify(title, body, duration)
    if self.Destroyed then return end
    duration = duration or 4
    local f = create("Frame", {
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = self.Colors.Sidebar,
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
    }, self.NotifyHolder)
    corner(f, 8)
    local bar = create("Frame", {Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = self.Colors.Accent, BorderSizePixel = 0}, f)
    corner(bar, 2)
    local t = create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 20), Position = UDim2.new(0, 12, 0, 6), BackgroundTransparency = 1,
        Text = tostring(title), TextColor3 = self.Colors.Accent, TextSize = 13, Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1,
    }, f)
    local b = create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 20), Position = UDim2.new(0, 12, 0, 27), BackgroundTransparency = 1,
        Text = tostring(body or ""), TextColor3 = self.Colors.Text, TextSize = 12, Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, TextTransparency = 1,
    }, f)
    local info = TweenInfo.new(0.25)
    TS:Create(f, info, {BackgroundTransparency = 0}):Play()
    TS:Create(t, info, {TextTransparency = 0}):Play()
    TS:Create(b, info, {TextTransparency = 0}):Play()
    task.delay(duration, function()
        if self.Destroyed or not f.Parent then return end
        TS:Create(f, info, {BackgroundTransparency = 1}):Play()
        TS:Create(t, info, {TextTransparency = 1}):Play()
        TS:Create(b, info, {TextTransparency = 1}):Play()
        task.wait(0.3)
        if f.Parent then f:Destroy() end
    end)
end

-- ---------- Config ----------
function Lib:_configPath(name)
    return self.ConfigFolder .. "/" .. (name or "default") .. ".json"
end

function Lib:SaveConfig(name)
    if not writefile then return false end
    local data = {}
    for flag, value in pairs(self.Flags) do
        local t = typeof(value)
        if t == "boolean" or t == "number" or t == "string" then
            data[flag] = value
        elseif t == "EnumItem" then
            data[flag] = {__key = value.Name}
        end
    end
    local ok = pcall(function()
        if makefolder and isfolder and not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
        writefile(self:_configPath(name), HttpService:JSONEncode(data))
    end)
    return ok
end

function Lib:LoadConfig(name)
    if not (readfile and isfile) then return false end
    local path = self:_configPath(name)
    if not isfile(path) then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" then return false end
    for flag, value in pairs(data) do
        local setter = self.Setters[flag]
        if setter then
            if type(value) == "table" and value.__key then
                value = Enum.KeyCode[value.__key]
            end
            if value ~= nil then pcall(setter, value) end
        end
    end
    return true
end

function Lib:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    self.Connections = {}
    if self.Gui then self.Gui:Destroy() end
end

