    local function createSlider(parent, st, order)
        local Row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 32),
            BackgroundTransparency = 1,
            LayoutOrder = order,
        }, parent)

        new("TextLabel", {
            Size = UDim2.new(0.6, -8, 0, 16),
            Position = UDim2.new(0, 8, 0, 3),
            BackgroundTransparency = 1,
            Text = st.name,
            TextColor3 = COLORS.text,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, Row)

        local ValueLabel = new("TextLabel", {
            Size = UDim2.new(0.4, -8, 0, 16),
            Position = UDim2.new(0.6, 0, 0, 3),
            BackgroundTransparency = 1,
            TextColor3 = COLORS.sub,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Right,
        }, Row)

        local Track = new("Frame", {
            Position = UDim2.new(0, 8, 0, 24),
            Size = UDim2.new(1, -16, 0, 2),
            BackgroundColor3 = COLORS.off,
            BorderSizePixel = 0,
        }, Row)
        local Fill = new("Frame", {
            Size = UDim2.new(0, 0, 1, 0),
            BackgroundColor3 = COLORS.accent,
            BorderSizePixel = 0,
        }, Track)
        track(Fill, "BackgroundColor3", "accent")
        local Knob = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.new(0, 8, 0, 8),
            Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = COLORS.text,
            BorderSizePixel = 0,
        }, Track)
        new("UICorner", {CornerRadius = UDim.new(1, 0)}, Knob)

        local Hit = new("TextButton", {
            Position = UDim2.new(0, 4, 0, 14),
            Size = UDim2.new(1, -8, 0, 18),
            BackgroundTransparency = 1,
            Text = "",
        }, Row)

        local function visual()
            local value = Features[st.key] or st.min
            local pos = math.clamp((value - st.min) / (st.max - st.min), 0, 1)
            Fill.Size = UDim2.new(pos, 0, 1, 0)
            Knob.Position = UDim2.new(pos, 0, 0.5, 0)
            ValueLabel.Text = tostring(value)
        end

        local function updateFromInput(input)
            local rel = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            setFeature(st.key, math.floor(st.min + (st.max - st.min) * rel + 0.5))
        end

        Hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                activeDrag = updateFromInput
                updateFromInput(input)
            end
        end)

        addRefresher(st.key, visual)
        visual()
    end

