    -- ---------- Đồng bộ trạng thái ----------
    local refreshers = {}
    local function addRefresher(key, fn)
        refreshers[key] = refreshers[key] or {}
        table.insert(refreshers[key], fn)
    end
    local function refresh(key)
        if refreshers[key] then
            for _, fn in ipairs(refreshers[key]) do fn() end
        end
    end

    -- Chọn giữa Click GUI (panel nhiều cột) và Classic (menu danh sách cũ)
    local menuOpen = true
    local khangWin, khangUpdate, khangSync, khangSyncKey, StyleCycle, classicScale
    local function updateMenus()
        local style = Features.PanelStyle
        ClickGui.Visible = menuOpen and style == 1
        MainFrame.Visible = menuOpen and style == 2
        if khangUpdate then khangUpdate(menuOpen and style >= 3, style) end
        if StyleCycle then
            StyleCycle.Visible = menuOpen
            StyleCycle.Text = "UI: " .. PANEL_STYLES[style].name .. "  ⇄"
        end
        if style == 2 then
            for _, fn in ipairs(LegacySync) do pcall(fn) end
        elseif style == 1 then
            for key in pairs(refreshers) do refresh(key) end
        end
    end

    local themed, panels = {}, {}
    local relayout, applyTheme

    local function track(obj, prop, colorKey)
        table.insert(themed, {obj = obj, prop = prop, colorKey = colorKey})
        return obj
    end

    applyTheme = function()
        local theme = THEMES[Features.ThemeIndex] or THEMES[1]
        local bg = BACKGROUNDS[Features.BgIndex] or BACKGROUNDS[1]
        COLORS.accent = theme.color
        COLORS.panel = bg.panel
        COLORS.settings = bg.settings
        for _, item in ipairs(themed) do
            pcall(function() item.obj[item.prop] = COLORS[item.colorKey] end)
        end
        if khangWin then pcall(function() khangWin:SetColors({Accent = COLORS.accent, Background = COLORS.panel, Sidebar = COLORS.settings, Element = COLORS.settings}) end) end
        for key in pairs(refreshers) do refresh(key) end
    end

    local setFeature
    local onChange = {
        EmotePlay = function(state)
            Custom.onEmoteToggle(state)
        end,
        AutoExec = function(state)
            Custom.onAutoExec(state)
        end,
        SkinPackIndex = function(index)
            Custom.onPackIndex(index)
        end,
        PanelStyle = function()
            menuOpen = true
            updateMenus()
        end,
        ThemeIndex = function() applyTheme() end,
        BgIndex = function() applyTheme() end,
        PanelScale = function(value)
            for _, p in ipairs(panels) do p.scale.Scale = value / 100 end
            if classicScale then classicScale.Scale = value / 100 end
            if khangWin then pcall(function() khangWin:SetScale(value / 100) end) end
            relayout()
        end,
        PanelTransparency = function(value)
            for _, p in ipairs(panels) do p.frame.BackgroundTransparency = value / 100 end
        end,
        PanelCorner = function(value)
            for _, p in ipairs(panels) do p.corner.CornerRadius = UDim.new(0, value) end
        end,
        SkinChanger = function(state)
            if state and not skinInitialized then
                skinInitialized = true
                local ok, err = pcall(InitSkinChanger)
                if not ok then warn("[Khang Hub] Skin Changer error: " .. tostring(err)) end
            end
        end,
        FPSBoost = function(state)
            if state then enableBoost() else disableBoost() end
        end,
        TexturePack = function(state)
            if state then enableTexturePack() else disableTexturePack() end
        end,
        MapDarkener = function(state)
            if state then enableDarkener() else disableDarkener() end
        end,
        Darkness = function(value)
            setDarkness(value)
        end,
        SkyChanger = function(state)
            if state then enableSky() else disableSky() end
        end,
        SkyPreset = function(index)
            local preset = SKY_PRESETS[index] or SKY_PRESETS[1]
            for key, value in pairs(Custom.skyPresetValues(preset)) do
                setFeature(key, value)
            end
        end,
    }

    setFeature = function(key, value)
        if Features[key] == value then return end
        Features[key] = value
        local cb = onChange[key]
        if cb then task.spawn(cb, value) end
        refresh(key)
        if khangSyncKey then khangSyncKey(key) end
        if UI_DEFAULTS[key] ~= nil then saveUI() end
    end

