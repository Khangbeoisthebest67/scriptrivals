-- RunService có bọc nhẹ để đo thời gian callback (bật "Perf Log" trong menu để xem; tắt thì gần như không tốn gì)
local RunService
do
    local real = game:GetService("RunService")
    local PERF = {enabled = false, stats = {}}

    local function wrapSignal(signal)
        return {
            Connect = function(_, fn)
                local label = tostring(debug.info(fn, "l") or "?")
                return signal:Connect(function(...)
                    if not PERF.enabled then return fn(...) end
                    local t0 = os.clock()
                    fn(...)
                    local elapsed = os.clock() - t0
                    local st = PERF.stats[label]
                    if not st then
                        st = {total = 0, count = 0, max = 0}
                        PERF.stats[label] = st
                    end
                    st.total += elapsed
                    st.count += 1
                    if elapsed > st.max then st.max = elapsed end
                end)
            end,
        }
    end

    RunService = setmetatable({}, {
        __index = function(_, key)
            if key == "KhangPerf" then return PERF end
            local value = real[key]
            if key == "RenderStepped" or key == "Heartbeat" or key == "Stepped" then
                return wrapSignal(value)
            elseif type(value) == "function" then
                return function(_, ...) return value(real, ...) end
            end
            return value
        end,
    })
end
