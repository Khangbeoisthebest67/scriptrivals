local function isEnemy(player)
    if not Features.TeamCheck then return true end
    if not player.Team or not LocalPlayer.Team then return true end
    return player.Team ~= LocalPlayer.Team
end

local targetLock = nil
local lastTargetTime = 0
local targetLockTime = 0.8
local lastTargetPosition = nil
local targetVelocity = Vector3.new(0, 0, 0)

local function getBestTarget()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then 
        return nil 
    end
    
    local bestTarget = nil
    local bestScore = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local localHRP = LocalPlayer.Character.HumanoidRootPart
    local localPos = localHRP.Position

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and isEnemy(player) then
            local head = player.Character:FindFirstChild("Head")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            
            if head and hrp and humanoid and humanoid.Health > 0 then
                local distance = (hrp.Position - localPos).Magnitude
                
                if distance <= Features.MaxDistance then
                    local aimPosition = head.Position + Vector3.new(0, Features.AimOffset, 0)
                    local screenPos, onScreen = Camera:WorldToViewportPoint(aimPosition)
                    
                    if onScreen then
                        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                        local distFromCenter = (screenPos2D - screenCenter).Magnitude
                        
                        local effectiveFOV = Features.FOV
                        if distance < 30 then
                            effectiveFOV = effectiveFOV * 2.0
                        elseif distance < 100 then
                            effectiveFOV = effectiveFOV * 1.3
                        end
                        
                        if distFromCenter <= effectiveFOV then
                            local distanceScore = distance < 50 and distance * 3 or distance * 0.5
                            local centerScore = distFromCenter * (distance < 30 and 0.3 or 1.0)
                            local score = centerScore + distanceScore
                            
                            if score < bestScore then
                                bestScore = score
                                bestTarget = {
                                    Head = head,
                                    HumanoidRootPart = hrp,
                                    Position = aimPosition,
                                    Distance = distance,
                                    Player = player
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    
    return bestTarget
end

local function getTargetWithLock()
    local currentTime = tick()
    
    if targetLock and targetLock.Head and targetLock.Head.Parent then
        local player = targetLock.Player
        if player and isEnemy(player) then
            local hrp = targetLock.HumanoidRootPart
            local humanoid = targetLock.Head.Parent:FindFirstChildOfClass("Humanoid")
            
            if hrp and humanoid and humanoid.Health > 0 then
                local distance = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                local aimPosition = targetLock.Head.Position + Vector3.new(0, Features.AimOffset, 0)
                local screenPos, onScreen = Camera:WorldToViewportPoint(aimPosition)
                
                if onScreen and distance <= Features.MaxDistance and (currentTime - lastTargetTime) < targetLockTime then
                    if lastTargetPosition then
                        targetVelocity = (aimPosition - lastTargetPosition) * 0.5
                    end
                    lastTargetPosition = aimPosition
                    lastTargetTime = currentTime
                    
                    targetLock.Position = aimPosition + (targetVelocity * 0.1)
                    targetLock.Distance = distance
                    return targetLock
                end
            end
        end
    end
    
    local newTarget = getBestTarget()
    if newTarget then
        targetLock = newTarget
        lastTargetTime = currentTime
        lastTargetPosition = newTarget.Position
        targetVelocity = Vector3.new(0, 0, 0)
    else
        targetLock = nil
        lastTargetPosition = nil
    end
    
    return targetLock
end

-- ===== COMBAT: AIM ASSIST + SILENT AIM + TRIGGER BOT + AUTO CLICKER =====
local AimbotCircle = Drawing.new("Circle")
AimbotCircle.Thickness = 1.5
AimbotCircle.NumSides = 64
AimbotCircle.Filled = false
AimbotCircle.Visible = false
AimbotCircle.Color = Color3.fromRGB(255, 170, 0)
AimbotCircle.Transparency = 0.6

do
    local TargetMarker = Drawing.new("Circle")
    TargetMarker.Thickness = 2
    TargetMarker.NumSides = 24
    TargetMarker.Radius = 7
    TargetMarker.Filled = false
    TargetMarker.Visible = false
    TargetMarker.Color = Color3.fromRGB(255, 60, 60)

    -- ---------- Hàm dùng chung ----------
    -- Dùng chung một RaycastParams (tạo mới liên tục rất tốn)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local rayParamsChar = nil
    local function getRayParams()
        local me = LocalPlayer.Character
        if rayParamsChar ~= me then
            rayParamsChar = me
            rayParams.FilterDescendantsInstances = {me}
        end
        return rayParams
    end

    -- Cache kết quả nhìn xuyên tường 0.12s / người (giảm mạnh số raycast mỗi lần quét)
    local visCache = setmetatable({}, {__mode = "k"})
    local function isVisible(targetPart, targetChar)
        local now = os.clock()
        local c = visCache[targetChar]
        if c and c.p == targetPart and now - c.t < 0.12 then return c.v end
        local origin = Camera.CFrame.Position
        local result = Workspace:Raycast(origin, targetPart.Position - origin, getRayParams())
        local v = result == nil or result.Instance:IsDescendantOf(targetChar)
        if c then
            c.t, c.v, c.p = now, v, targetPart
        else
            visCache[targetChar] = {t = now, v = v, p = targetPart}
        end
        return v
    end

    -- kind: 1 = Head, 2 = Torso, 3 = Root
    local function getAimPart(character, kind)
        if kind == 1 then
            return character:FindFirstChild("Head")
        elseif kind == 2 then
            return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
        end
        return character:FindFirstChild("HumanoidRootPart")
    end

    -- setting: 1 Head, 2 Torso, 3 Root, 4 Random
    local function pickKind(setting, headChance)
        if setting == 1 then
            return (math.random() * 100 < headChance) and 1 or 2
        elseif setting == 4 then
            if math.random() * 100 < headChance then return 1 end
            return math.random(2, 3)
        end
        return setting
    end

    local function findTarget(range, fov, wallCheck, kind, lockedPlayer, lockFov)
        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end

        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local best, bestScore = nil, math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and isEnemy(player) then
                local c = player.Character
                local hum = c:FindFirstChildOfClass("Humanoid")
                local root = c:FindFirstChild("HumanoidRootPart")
                local part = getAimPart(c, kind)
                if hum and hum.Health > 0 and root and part
                    and hum.Health / math.max(hum.MaxHealth, 1) * 100 <= Features.TargetHPMax
                    and (root.Position - myRoot.Position).Magnitude <= range then
                    local pos = part.Position + Vector3.new(0, Features.AimOffset, 0)
                    local sp, onScreen = Camera:WorldToViewportPoint(pos)
                    if onScreen then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        local isLocked = (player == lockedPlayer)
                        local limit = isLocked and (lockFov or fov) or fov
                        local usePart, visible = part, true
                        if d <= limit and wallCheck then
                            visible = isVisible(part, c)
                            if not visible and kind == 1 then
                                -- Đầu bị che nhưng thân còn thấy: vẫn nhắm vào thân thay vì bỏ mục tiêu
                                local alt = getAimPart(c, 2)
                                if alt and isVisible(alt, c) then usePart, visible = alt, true end
                            end
                        end
                        if d <= limit and visible then
                            local score = isLocked and (d * 0.25) or d -- ưu tiên giữ mục tiêu đang khóa
                            if score < bestScore then
                                bestScore = score
                                best = {player = player, character = c, part = usePart,
                                    position = usePart.Position + Vector3.new(0, Features.AimOffset, 0), distance = d}
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    -- Rage Bot: chọn mục tiêu bất kể FOV (ưu tiên: gần nhất / máu thấp nhất / gần tâm nhất)
    local function findRageTarget()
        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end

        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local best, bestScore = nil, math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and isEnemy(player) then
                local c = player.Character
                local hum = c:FindFirstChildOfClass("Humanoid")
                local root = c:FindFirstChild("HumanoidRootPart")
                local head = c:FindFirstChild("Head")
                local aim = head or root
                if hum and hum.Health > 0 and root and aim
                    and hum.Health / math.max(hum.MaxHealth, 1) * 100 <= Features.TargetHPMax then
                    local dist = (root.Position - myRoot.Position).Magnitude
                    if dist <= Features.RageRange and (Features.RageTP or not Features.RageWallCheck or isVisible(aim, c)) then
                        local score
                        if Features.RagePriority == 2 then
                            score = hum.Health
                        elseif Features.RagePriority == 3 then
                            local sp = Camera:WorldToViewportPoint(aim.Position)
                            score = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        else
                            score = dist
                        end
                        if score < bestScore then
                            bestScore = score
                            best = {
                                player = player, character = c, part = aim, position = aim.Position, distance = 0,
                                parts = {head, c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso"), root},
                            }
                        end
                    end
                end
            end
        end
        return best
    end

    local function doClick()
