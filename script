    -- Chia nhóm cho từng rule (bật / tắt riêng từng nhóm trong menu)
    local RANK_FILES = {["top200xrank.png"] = true, ["nemx.png"] = true}
    for _, f in ipairs({"f", "d-", "d", "d+", "c-", "c", "c+", "b-", "b", "b+", "a-", "a", "a+", "s", "ss", "u"}) do
        RANK_FILES[f .. ".png"] = true
    end
    local KILL_FILES = {["kill1.ogg"] = true, ["kill2.ogg"] = true, ["kill3.ogg"] = true, ["elimin.mp3"] = true}
    local MATCH_FILES = {
        ["allclear.base.ogg"] = true, ["winnerwinner.ogg"] = true, ["showscore.base.ogg"] = true,
        ["studio-audience-awwww-sound-fx.mp3"] = true, ["final-fantasy-vii-victory-fanfare-1.mp3"] = true,
    }
    local MOVE_FILES = {["Sliding.mp3"] = true}
    local MENU_FILES = {["menuclick.base.ogg"] = true, ["achievement_3.base.ogg"] = true, ["target.base.ogg"] = true}
    local UI_ASSETS = {["rbxassetid://72106446453934"] = true}

    local function categoryOf(rule)
        local url = rule.url
        local file = url:match("([^/]+)$") or url
        if RANK_FILES[file] then return "TexRanks" end
        if KILL_FILES[file] then return "TexKillSounds" end
        if MATCH_FILES[file] then return "TexMatchSounds" end
        if MOVE_FILES[file] then return "TexMoveSounds" end
        if MENU_FILES[file] then return "TexMenuSounds" end
        if file:match("%.png$") or file:match("%.webp$") or UI_ASSETS[url] then return "TexUI" end
        return "TexOtherSounds"
    end

    for _, rule in ipairs(Rules) do
        rule.cat = categoryOf(rule)
        for _, id in ipairs(rule.ids) do IdMap[tostring(id)] = rule end
    end

    -- Chỉ tải các nhóm đang bật (không chặn lúc load script)
    local function ensureAssets()
        for _, rule in ipairs(Rules) do
            if khangUnloaded then return end
            if rule.asset == nil and Features[rule.cat] ~= false then
                rule.asset = getAsset(rule.url)
            end
        end
    end

    Custom.resolveAsset = getAsset

    local function restoreAllOriginalAssets()
        for obj, props in pairs(OriginalAssets) do
            if obj and obj.Parent then
                for propName, origVal in pairs(props) do
                    pcall(function() obj[propName] = origVal end)
                end
            end
        end
        table.clear(OriginalAssets)
    end

    local function applyTextureSwap(obj)
        if khangUnloaded or not packEnabled or not obj then return end

        local function replace(property)
            local success, value = pcall(function() return obj[property] end)
            if not success or type(value) ~= "string" then return end

            local id = string.match(value, "%d+")
            local rule = id and IdMap[id]
            if rule and rule.asset and Features[rule.cat] ~= false then
                if not OriginalAssets[obj] then OriginalAssets[obj] = {} end
                if not OriginalAssets[obj][property] then OriginalAssets[obj][property] = value end
                pcall(function() obj[property] = rule.asset end)
            end
        end

        if obj:IsA("Sound") then replace("SoundId")
        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then replace("Image")
        elseif obj:IsA("Decal") or obj:IsA("Texture") then replace("Texture")
        elseif obj:IsA("MeshPart") then replace("TextureID") end
    end

    function enableTexturePack()
        if packEnabled then return end
        packEnabled = true
        task.spawn(function()
            ensureAssets()
            if not packEnabled or khangUnloaded then return end
            batchProcess(game:GetDescendants(), applyTextureSwap, 150)
            textureConn = game.DescendantAdded:Connect(function(obj)
                if packEnabled and not khangUnloaded and (obj:IsA("Sound") or obj:IsA("ImageLabel") or obj:IsA("ImageButton") or obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("MeshPart")) then
                    task.defer(applyTextureSwap, obj)
                end
            end)
        end)
    end

    function disableTexturePack()
        packEnabled = false
        if textureConn then
            textureConn:Disconnect()
            textureConn = nil
        end
        restoreAllOriginalAssets()
    end

    function Custom.isTextureActive()
        return packEnabled
    end

    -- Áp dụng lại khi bật / tắt một nhóm
    function Custom.refreshTexturePack()
        if not packEnabled then return end
        restoreAllOriginalAssets()
        task.spawn(function()
            ensureAssets()
            if packEnabled and not khangUnloaded then
                batchProcess(game:GetDescendants(), applyTextureSwap, 150)
            end
        end)
    end
end

-- ---------- Map darkener ----------
do
    local darkenerEnabled, darknessLevel = false, 10
    local originalPartColors = {}
    local originalLighting = nil
    local darkenerConn = nil
    local darkenerRestoring = false

    local function getMultiplier()
        return (10 - darknessLevel) * 0.06
    end

    local function updateLighting()
        if darkenerEnabled and not khangUnloaded then
            local mult = getMultiplier()
            Lighting.Brightness = mult
            Lighting.OutdoorAmbient = Color3.fromRGB(math.floor(20 * mult), math.floor(20 * mult), math.floor(25 * mult))
            Lighting.Ambient = Color3.fromRGB(math.floor(15 * mult), math.floor(15 * mult), math.floor(20 * mult))
        end
    end

    local function darkenInstance(part)
        if khangUnloaded or not darkenerEnabled or not part or not part:IsA("BasePart") or not part:IsDescendantOf(Workspace) then return end

        local model = part:FindFirstAncestorOfClass("Model")
        if model and Players:GetPlayerFromCharacter(model) then return end
        if part.Name == "HumanoidRootPart" or (part.Parent and part.Parent.Name == "Camera") then return end

        if not originalPartColors[part] then
            originalPartColors[part] = part.Color
        end
        local h, s, v = Color3.toHSV(originalPartColors[part])
        part.Color = Color3.fromHSV(h, s, math.clamp(v * getMultiplier(), 0, 1))
    end

    local function applyDarknessToAll()
        updateLighting()
        batchProcess(Workspace:GetDescendants(), darkenInstance, 200)
    end

    function enableDarkener()
        if darkenerEnabled then return end
        darkenerEnabled = true

        -- Chờ lần khôi phục trước xong để không lưu nhầm màu/ánh sáng đã bị chỉnh
        while darkenerRestoring do task.wait() end
        if not darkenerEnabled then return end

        originalLighting = {
            Brightness = Lighting.Brightness,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            Ambient = Lighting.Ambient
        }
        applyDarknessToAll()
        darkenerConn = Workspace.DescendantAdded:Connect(function(obj)
            if darkenerEnabled and not khangUnloaded and obj:IsA("BasePart") then
                task.defer(darkenInstance, obj)
            end
        end)
    end

    function disableDarkener()
        if not darkenerEnabled then return end
        darkenerEnabled = false
        if darkenerConn then
            darkenerConn:Disconnect()
            darkenerConn = nil
        end

        pcall(function()
            if originalLighting then
                Lighting.Brightness = originalLighting.Brightness
                Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
                Lighting.Ambient = originalLighting.Ambient
            end
        end)
        originalLighting = nil

        local items = {}
        for part, color in pairs(originalPartColors) do
            items[#items + 1] = {part, color}
        end
        originalPartColors = {}
        darkenerRestoring = true
        task.spawn(function()
            pcall(function()
                for i, item in ipairs(items) do
                    local part, color = item[1], item[2]
                    if part and part.Parent then
                        pcall(function() part.Color = color end)
                    end
                    if i % 500 == 0 then task.wait() end
                end
            end)
            darkenerRestoring = false
        end)
    end

    function setDarkness(level)
        darknessLevel = level
        if darkenerEnabled then applyDarknessToAll() end
    end

    function Custom.isDarkenerActive()
        return darkenerEnabled
    end
end

-- ---------- Map texture (đổi ảnh / chất liệu của map) ----------
do
    local active, conn = false, nil
    local original = setmetatable({}, {__mode = "k"})
    local currentAsset, currentMaterial = nil, nil

    local function resolveSource()
        local src = tostring(Features.MapTextureSource or ""):match("^%s*(.-)%s*$")
        if src == "" then return nil end
        if src:match("^%d+$") then return "rbxassetid://" .. src end
        if src:match("^https?://") and Custom.resolveAsset then return Custom.resolveAsset(src) end
        return src
    end

    local function resolveMaterial()
        local option = Custom.MAP_MATERIALS[Features.MapMaterialIndex]
        if option and option.mat then return Enum.Material[option.mat] end
        return nil
    end

    local function isMapObject(obj)
        if obj:IsDescendantOf(Camera) then return false end -- viewmodel
        local model = obj:FindFirstAncestorOfClass("Model")
        if model and Players:GetPlayerFromCharacter(model) then return false end
        return true
    end

    local function remember(obj, prop, value)
        local entry = original[obj]
        if not entry then entry = {} original[obj] = entry end
        if entry[prop] == nil then entry[prop] = value end
    end

    local function applyTo(obj)
        if khangUnloaded or not active or not obj or not obj:IsDescendantOf(Workspace) then return end
        if obj:IsA("Decal") or obj:IsA("Texture") then
            if currentAsset and isMapObject(obj) then
                remember(obj, "Texture", obj.Texture)
                obj.Texture = currentAsset
            end
        elseif obj:IsA("BasePart") and not obj:IsA("Terrain") then
            if currentMaterial and isMapObject(obj) then
                remember(obj, "Material", obj.Material)
                obj.Material = currentMaterial
            end
        end
    end

    local function restoreAll()
        local items = {}
        for obj, props in pairs(original) do items[#items + 1] = {obj, props} end
        original = setmetatable({}, {__mode = "k"})
        task.spawn(function()
            for i, item in ipairs(items) do
                local obj, props = item[1], item[2]
                if obj and obj.Parent then
                    for prop, value in pairs(props) do pcall(function() obj[prop] = value end) end
                end
                if i % 400 == 0 then task.wait() end
            end
        end)
    end

    local function applyAll()
        task.spawn(function()
            currentAsset = resolveSource()
            currentMaterial = resolveMaterial()
            if not active or khangUnloaded then return end
            batchProcess(Workspace:GetDescendants(), applyTo, 200)
        end)
    end

    function Custom.mapTexEnable()
        if active then return end
        active = true
        applyAll()
        conn = Workspace.DescendantAdded:Connect(function(obj)
            if active and not khangUnloaded then task.defer(applyTo, obj) end
        end)
    end

    function Custom.mapTexDisable()
        active = false
        if conn then conn:Disconnect() conn = nil end
        restoreAll()
    end

    function Custom.mapTexRefresh()
        if not active then return end
        restoreAll()
        applyAll()
    end

    function Custom.isMapTexActive()
        return active
    end
end

-- ---------- Âm thanh Dash / Double Jump ----------
-- Game không báo sự kiện dash / double jump ra ngoài, nên script nhận diện qua chuyển động:
--   Dash       = tốc độ ngang tăng vọt trong 1 frame
--   Double jump = đang ở trên không rồi vận tốc đi lên tăng vọt
do
    local SoundService = game:GetService("SoundService")
    local Debris = game:GetService("Debris")
    local cache = {}

    local function resolveSound(index, custom)
        local option = Custom.SOUND_PRESETS[index]
        if not option or option.name == "Off" then return nil end
        local src
        if option.name == "Custom" then
            local text = tostring(custom or ""):match("^%s*(.-)%s*$")
            if text == "" then return nil end
            src = text:match("^%d+$") and ("rbxassetid://" .. text) or text
        else
            src = option.url
        end
        if not src then return nil end
        if cache[src] then return cache[src] end
        local asset = src
        if src:match("^https?://") and Custom.resolveAsset then asset = Custom.resolveAsset(src) end
        cache[src] = asset
        return asset
    end

    local function playSound(index, custom, volume)
        task.spawn(function()
            local ok, asset = pcall(resolveSound, index, custom)
            if not ok or not asset then return end
            local snd = Instance.new("Sound")
            snd.SoundId = asset
            snd.Volume = math.clamp(volume / 100, 0, 1) * 2
            snd.Parent = SoundService
            snd:Play()
            Debris:AddItem(snd, 6)
        end)
    end

    function Custom.testDashSound()
        playSound(Features.DashSoundIndex, Features.DashSoundCustom, Features.DashVolume)
    end
    function Custom.testJumpSound()
        playSound(Features.DoubleJumpSoundIndex, Features.DoubleJumpSoundCustom, Features.DJVolume)
    end

    local lastSpeed, lastVy, airTime = 0, 0, 0
    local lastDash, lastJump = 0, 0
    local warm = 0

    RunService.Heartbeat:Connect(function(dt)
        if khangUnloaded then return end

        -- Tải sẵn âm thanh đã chọn để lần phát đầu không bị trễ
        warm += dt
        if warm >= 2 then
            warm = 0
            if Features.DashSound then task.spawn(pcall, resolveSound, Features.DashSoundIndex, Features.DashSoundCustom) end
            if Features.DoubleJumpSound then task.spawn(pcall, resolveSound, Features.DoubleJumpSoundIndex, Features.DoubleJumpSoundCustom) end
        end

        if not (Features.DashSound or Features.DoubleJumpSound) then return end
        local hum, root = getHumanoid(), getRoot()
        if not hum or not root or hum.Health <= 0 then return end

        local v = root.AssemblyLinearVelocity
        local horizontal = Vector3.new(v.X, 0, v.Z).Magnitude
        local now = os.clock()

        if hum.FloorMaterial == Enum.Material.Air then airTime += dt else airTime = 0 end

        if not Features.Fly and not Features.TargetStrafe then
            if Features.DashSound and horizontal - lastSpeed > Features.DashSens and now - lastDash > 0.5 then
                lastDash = now
                playSound(Features.DashSoundIndex, Features.DashSoundCustom, Features.DashVolume)
            end
            if Features.DoubleJumpSound and airTime > 0.12 and v.Y - lastVy > Features.DJSens and now - lastJump > 0.4 then
                lastJump = now
                playSound(Features.DoubleJumpSoundIndex, Features.DoubleJumpSoundCustom, Features.DJVolume)
            end
        end
        lastSpeed, lastVy = horizontal, v.Y
    end)
end

