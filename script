    tab.Panel, tab.Body, tab.Resize = panel, body, resize

    local function select()
        win.CurrentTab = tab
        if win.Style == 3 then return end
        for _, t in ipairs(win.Tabs) do
            local active = t == tab
            t.Page.Visible = active
            t.Button.BackgroundTransparency = active and 0 or 1
            t.Button.TextColor3 = active and Color3.new(1, 1, 1) or win.Colors.SubText
        end
    end
    btn.MouseButton1Click:Connect(select)
    tab.Select = select
    if #win.Tabs == 1 then select() end

    win:_track(btn, "BackgroundColor3", "Accent")
    win:SetStyle(win.Style)
    return tab
