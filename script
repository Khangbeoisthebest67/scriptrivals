    -- ---------- Hàm dùng cho Skin Packs ----------
    -- Chụp lại loadout đang trang bị: [vũ khí][loại] = {name, seed, inverted}
    Custom.skinGetEquipped = function()
        local out = {}
        for weapon, cosmetics in pairs(equipped) do
            out[weapon] = {}
            for cType, d in pairs(cosmetics) do
                if d and d.Name then
                    out[weapon][cType] = {name = d.Name, seed = d.Seed, inverted = d.Inverted}
                end
            end
        end
        return out
    end

    -- Áp dụng cả pack: thay toàn bộ loadout hiện tại
    Custom.skinApply = function(pack)
        for key in pairs(equipped) do equipped[key] = nil end
        local applied, missing = 0, 0
        for weapon, cosmetics in pairs(pack) do
            for cType, d in pairs(cosmetics) do
                local cloned = type(d) == "table" and d.name and cloneCosmetic(d.name, cType, {inverted = d.inverted})
                if cloned then
                    if d.seed then cloned.Seed = d.seed end
                    equipped[weapon] = equipped[weapon] or {}
                    equipped[weapon][cType] = cloned
                    applied += 1
                else
                    missing += 1
                end
            end
        end
        pcall(function() DataController.CurrentData:Replicate("WeaponInventory") end)
        saveConfig()
        return applied, missing
    end

    -- Reroll: mỗi SÚNG nhận ngẫu nhiên 1 skin CỦA CHÍNH SÚNG ĐÓ (không lẫn skin súng khác).
    -- Wrap / Charm: chỉ lấy loại dùng được cho súng đó (hoặc loại dùng chung nếu game không ghi rõ súng).
    local WEAPON_FIELDS = {"Weapon", "WeaponName", "Weapons", "Gun", "ForWeapon", "BaseWeapon"}

    local function weaponsOf(name, c)
        local set = {}
        local function add(v)
            if type(v) == "string" and v ~= "" then
                set[v] = true
            elseif type(v) == "table" then
                for _, x in pairs(v) do
                    if type(x) == "string" then set[x] = true end
                end
            end
        end
        for _, f in ipairs(WEAPON_FIELDS) do add(c[f]) end
        if next(set) == nil then
            local vm = ItemLibrary.ViewModels and ItemLibrary.ViewModels[name]
            if type(vm) == "table" then
                for _, f in ipairs(WEAPON_FIELDS) do add(vm[f]) end
            end
        end
        return set
    end

    Custom.skinReroll = function()
        local skinsByWeapon = {}   -- [súng] = {tên skin...}
        local universal = {Wrap = {}, Charm = {}}
        local weaponSpecific = {Wrap = {}, Charm = {}} -- [loại][súng] = {tên...}
        local weaponSet, mappedAny = {}, false

        for name, c in pairs(CosmeticLibrary.Cosmetics) do
            if type(c) == "table" and not tostring(name):find("MISSING_") and allowed(c) then
                local kind = cosmeticKind(c)
                if kind == "Skin" or kind == "Wrap" or kind == "Charm" then
                    local weapons = weaponsOf(name, c)
                    local hasWeapon = next(weapons) ~= nil
                    if kind == "Skin" then
                        for w in pairs(weapons) do
                            skinsByWeapon[w] = skinsByWeapon[w] or {}
                            table.insert(skinsByWeapon[w], name)
                            weaponSet[w] = true
                            mappedAny = true
                        end
                    elseif hasWeapon then
                        for w in pairs(weapons) do
                            weaponSpecific[kind][w] = weaponSpecific[kind][w] or {}
                            table.insert(weaponSpecific[kind][w], name)
                        end
                    else
                        table.insert(universal[kind], name)
                    end
                end
            end
        end

        if not mappedAny then return 0, false end

        local function pick(list)
            if list and #list > 0 then return list[math.random(#list)] end
            return nil
        end

        local changed = 0
        for weapon in pairs(weaponSet) do
            local skin = pick(skinsByWeapon[weapon])
            if skin then
                local cloned = cloneCosmetic(skin, "Skin")
                if cloned then
                    equipped[weapon] = equipped[weapon] or {}
                    equipped[weapon].Skin = cloned
                    -- Wrap / Charm chỉ đổi nếu súng này đang có sẵn (không tự thêm mới)
                    for _, kind in ipairs({"Wrap", "Charm"}) do
                        if equipped[weapon][kind] then
                            local list = weaponSpecific[kind][weapon]
                            if not list or #list == 0 then list = universal[kind] end
                            local choice = pick(list)
                            local c2 = choice and cloneCosmetic(choice, kind)
                            if c2 then equipped[weapon][kind] = c2 end
                        end
                    end
                    changed += 1
                    dbg("Reroll", weapon, "->", skin)
                end
            end
        end

        pcall(function() DataController.CurrentData:Replicate("WeaponInventory") end)
        saveConfig()
        return changed, true
    end

    -- Ghi toàn bộ tên cosmetic ra file để biết đúng tên khi tự làm pack
    Custom.skinDump = function()
        local lines = {}
        for name, cosmetic in pairs(CosmeticLibrary.Cosmetics) do
            local parts = {tostring(name)}
            if type(cosmetic) == "table" then
                local fields = {}
                for k, v in pairs(cosmetic) do
                    local t = type(v)
                    if t == "string" or t == "number" or t == "boolean" then
                        table.insert(fields, tostring(k) .. "=" .. tostring(v))
                    end
                end
                table.sort(fields)
                for _, field in ipairs(fields) do table.insert(parts, field) end
            end
            table.insert(lines, table.concat(parts, " | "))
        end
        table.sort(lines)
        pcall(function()
            if makefolder and isfolder and not isfolder("KhangHub") then makefolder("KhangHub") end
            writefile("KhangHub/cosmetics.txt", table.concat(lines, "\n"))
        end)
        return #lines
    end

    -- Danh sách độ hiếm lấy từ chính dữ liệu game
    do
        local set, names = {}, {}
        for _, c in pairs(CosmeticLibrary.Cosmetics) do
            if type(c) == "table" and c.Rarity ~= nil then set[tostring(c.Rarity)] = true end
        end
        for r in pairs(set) do names[#names + 1] = r end
        table.sort(names)
        for i = #Custom.rarityOptions, 2, -1 do table.remove(Custom.rarityOptions, i) end
        for _, r in ipairs(names) do table.insert(Custom.rarityOptions, {name = r}) end
        if Features.UnlockRarity > #Custom.rarityOptions then Features.UnlockRarity = 1 end
        if Custom.syncUI then Custom.syncUI() end
    end

    loadConfig()
end

