    local khangElements, khangBinds = {}, {}
    local khangBuilding, khangBuilt = true, false

    local function khNames(options)
        local list = {}
        for i, option in ipairs(options) do list[i] = option.name end
        return list
    end

    local function khRegister(key, kind, obj, st)
        khangElements[key] = khangElements[key] or {}
        table.insert(khangElements[key], {kind = kind, obj = obj, st = st})
    end

    local function khAdd(tab, st)
        local key = st.key
        if st.type == "slider" then
            khRegister(key, "slider", tab:AddSlider({
                Name = st.name, Min = st.min, Max = st.max,
                Default = math.clamp(Features[key] or st.min, st.min, st.max),
                Callback = function(v) if not khangBuilding then setFeature(key, v) end end,
            }), st)
        elseif st.type == "cycle" then
            local list = khNames(st.options)
            khRegister(key, "cycle", tab:AddDropdown({
                Name = st.name, Options = list, Default = list[Features[key]] or list[1],
                Callback = function(chosen)
                    if khangBuilding then return end
                    for i, option in ipairs(st.options) do
                        if option.name == chosen then setFeature(key, i) break end
                    end
                end,
            }), st)
        elseif st.type == "button" then
            tab:AddButton({Name = st.name, Callback = function() st.action() end})
        elseif st.type == "textbox" then
            khRegister(key, "textbox", tab:AddTextBox({
                Name = st.name, Placeholder = st.placeholder, Default = tostring(Features[key] or ""),
                Callback = function(text) if not khangBuilding then setFeature(key, text) end end,
            }), st)
        else
            khRegister(key, "toggle", tab:AddToggle({
                Name = st.name, Default = Features[key] and true or false,
                Callback = function(v) if not khangBuilding then setFeature(key, v) end end,
            }), st)
        end
    end

    khangSyncKey = function(key)
        local list = khangElements[key]
        if not list then return end
        local was = khangBuilding
        khangBuilding = true
        for _, e in ipairs(list) do
            pcall(function()
                if e.kind == "toggle" then
                    e.obj:Set(Features[key] and true or false, true)
                elseif e.kind == "slider" then
                    e.obj:Set(Features[key] or e.st.min, true)
                elseif e.kind == "cycle" then
                    local names = khNames(e.st.options)
                    e.obj:SetOptions(names)
                    e.obj:Set(names[Features[key]] or names[1], true)
                elseif e.kind == "textbox" then
                    e.obj:Set(tostring(Features[key] or ""), true)
                end
            end)
        end
        khangBuilding = was
    end

    khangSync = function()
        for key in pairs(khangElements) do khangSyncKey(key) end
        local was = khangBuilding
        khangBuilding = true
        for mod, kb in pairs(khangBinds) do pcall(function() kb:Set(mod.bind) end) end
        khangBuilding = was
    end

    local function buildKhang(style)
        khangBuilt = true
        khangBuilding = true
        local ok, err = pcall(function()
            khangWin = KhangUILib.new({
                Title = "Khang Hub", Style = style - 2, Accent = COLORS.accent,
                Colors = {Background = COLORS.panel, Sidebar = COLORS.settings, Element = COLORS.settings, Off = Color3.fromRGB(50, 50, 56)},
                ToggleKey = false, HideStyleButton = true,
            })
            khangWin:SetScale(Features.PanelScale / 100)
            for _, cat in ipairs(Layout) do
                local tab = khangWin:AddTab(cat.name)
                for _, mod in ipairs(cat.modules) do
                    if mod.key then
                        if mod.settings then
                            tab:AddSection(mod.name)
                            khAdd(tab, {type = "toggle", name = "Enabled", key = mod.key})
                            for _, st in ipairs(mod.settings) do khAdd(tab, st) end
                        else
                            khAdd(tab, {type = "toggle", name = mod.name, key = mod.key})
                        end
                        -- Phím tắt dùng chung với hệ thống Bind của UI cũ (mod.bind)
                        khangBinds[mod] = tab:AddKeybind({
                            Name = mod.settings and "Bind" or (mod.name .. " bind"),
                            Default = mod.bind,
                            OnChanged = function(k)
                                mod.bind = k
                                if mod.bindButton then mod.bindButton.Text = k and ("Bind: " .. k.Name) or "Bind: None" end
                            end,
                        })
                    elseif mod.settings then
                        tab:AddSection(mod.name)
                        for _, st in ipairs(mod.settings) do khAdd(tab, st) end
                    elseif mod.action then
                        tab:AddButton({Name = mod.name, Color = mod.color, Callback = function(btn) mod.action(btn) end})
                    end
                end
            end
        end)
        khangBuilding = false
        if not ok then
            warn("[Khang Hub] KhangUI error: " .. tostring(err))
            showNotification("KhangUI", "Lỗi dựng giao diện, xem F9", 5)
        end
    end

    khangUpdate = function(show, style)
        if show and not khangBuilt then buildKhang(style) end
        if khangWin then
            if show then
                khangWin:SetStyle(style - 2)
                khangSync()
            end
            khangWin:SetVisible(show)
        end
        KhangModal.Visible = show
    end

    Custom.khangVisible = function() return khangWin ~= nil and khangWin.Shown end
    Custom.setUIScale = function(v) setFeature("PanelScale", v) end

    local origUnload = unloadHub
    unloadHub = function()
