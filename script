local boostBackup = {}
local boostLighting, boostTerrain, boostEffects = nil, nil, {}
local boostConn, boostQuality = nil, nil
local boostActive, boostToken, boostRestoring = false, 0, false

local function boostInstance(v)
    if v:IsA("BasePart") and not v:IsA("Terrain") then
        if boostBackup[v] == nil then
            boostBackup[v] = {Material = v.Material, Reflectance = v.Reflectance, CastShadow = v.CastShadow}
        end
        v.Material = Enum.Material.SmoothPlastic
        v.Reflectance = 0
        v.CastShadow = false
    elseif v:IsA("Decal") or v:IsA("Texture") then
        if boostBackup[v] == nil then boostBackup[v] = {Transparency = v.Transparency} end
        v.Transparency = 1
    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
        if boostBackup[v] == nil then boostBackup[v] = {Enabled = v.Enabled} end
        v.Enabled = false
    end
end

-- Chỉ áp dụng nếu FPS Boost vẫn đang bật (tránh áp dụng muộn sau khi đã tắt)
local function boostDeferred(v)
    if boostActive then pcall(boostInstance, v) end
end

function enableBoost()
    if boostActive then return end
    boostActive = true
    boostToken += 1
    local token = boostToken

    -- Chờ lần khôi phục trước (nếu đang chạy) xong, tránh lưu nhầm giá trị đã bị chỉnh
    while boostRestoring do task.wait() end
    if token ~= boostToken or not boostActive then return end

    -- Chất lượng đồ họa
    pcall(function()
        boostQuality = settings().Rendering.QualityLevel
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    -- Ánh sáng + hiệu ứng hậu kỳ
    pcall(function()
        boostLighting = {GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd}
        Lighting.GlobalShadows = false
    end)
    boostEffects = {}
    pcall(function()
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("PostEffect") then
                boostEffects[child] = child.Enabled
                child.Enabled = false
            end
        end
    end)

    -- Nước
    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            boostTerrain = {
                WaterWaveSize = terrain.WaterWaveSize,
                WaterWaveSpeed = terrain.WaterWaveSpeed,
                WaterReflectance = terrain.WaterReflectance,
                WaterTransparency = terrain.WaterTransparency
            }
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0
        end
    end)

    -- Vật thể hiện có (chia nhỏ để không đơ game)
    task.spawn(function()
        local count = 0
        for _, v in ipairs(Workspace:GetDescendants()) do
            if token ~= boostToken or not boostActive then return end
            pcall(boostInstance, v)
            count += 1
            if count % 500 == 0 then task.wait() end
        end
    end)

    -- Vật thể mới xuất hiện
    boostConn = Workspace.DescendantAdded:Connect(function(v)
        if boostActive then task.defer(boostDeferred, v) end
    end)
end

function disableBoost()
    if not boostActive then return end
    boostActive = false
    boostToken += 1
    if boostConn then boostConn:Disconnect() boostConn = nil end

    -- Mỗi bước bọc pcall riêng để một lỗi nhỏ không làm các bước sau không chạy
    pcall(function()
        if boostQuality then settings().Rendering.QualityLevel = boostQuality end
    end)

    pcall(function()
        if boostLighting then
            for key, value in pairs(boostLighting) do Lighting[key] = value end
        end
    end)
    boostLighting = nil

    pcall(function()
        for effect, enabled in pairs(boostEffects) do
            if effect and effect.Parent then effect.Enabled = enabled end
        end
    end)
    boostEffects = {}

    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain and boostTerrain then
            for key, value in pairs(boostTerrain) do terrain[key] = value end
        end
    end)
    boostTerrain = nil

    -- Khôi phục vật thể: lấy danh sách cố định rồi khôi phục dần
    local items = {}
    for inst, props in pairs(boostBackup) do
        items[#items + 1] = {inst, props}
    end
    boostBackup = {}
    boostRestoring = true
    task.spawn(function()
        pcall(function()
            for i, item in ipairs(items) do
                local inst, props = item[1], item[2]
                if inst and inst.Parent then
                    for key, value in pairs(props) do
                        pcall(function() inst[key] = value end)
                    end
                end
                if i % 400 == 0 then task.wait() end
            end
        end)
        boostRestoring = false
    end)
end

