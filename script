        -- Chiều cao panel = nội dung, nhưng tối đa bằng chiều cao màn hình (phần dư sẽ cuộn)
        entry.resize = function()
            local scale = Features.PanelScale / 100
            local maxHeight = math.max(140, (Camera.ViewportSize.Y - 80 - 20) / scale)
            local content = BodyLayout.AbsoluteContentSize.Y + 8
