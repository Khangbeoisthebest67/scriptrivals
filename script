    -- ---------- Silent Aim ----------
    local silentTarget = nil
    local decision = {time = 0, point = nil, part = nil}
    local lastFireTime = 0
    local raycastHooked, mouseHooked, warnedNoHook = false, false, false

    local function updateSilentTarget()
        if not Features.SilentAim then
            silentTarget = nil
            return
        end
        local now = os.clock()
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then lastFireTime = now end

        -- Súng giật làm tâm ngắm trôi ra khỏi vòng FOV sau vài viên đầu, mục tiêu bị rớt nên các viên sau
        -- bắn thường. Khi đang bắn: giữ nguyên mục tiêu cho tới khi chết / quá tầm / bị che quá 0.35s.
        local cur = silentTarget
        if Features.SilentSticky and cur and now - lastFireTime < 0.6 and cur.character then
            local hum = cur.character:FindFirstChildOfClass("Humanoid")
            local root = cur.character:FindFirstChild("HumanoidRootPart")
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root and cur.part.Parent and myRoot
                and (root.Position - myRoot.Position).Magnitude <= Features.SilentRange then
                if not Features.SilentWallCheck or isVisible(cur.part, cur.character) then
                    cur.lostAt = nil
                    return
                end
                cur.lostAt = cur.lostAt or now
                if now - cur.lostAt < 0.35 then return end
            end
        end

        local scanKind = (Features.SilentPart == 1) and 1 or ((Features.SilentPart == 3) and 3 or 2)
        local target = findTarget(Features.SilentRange, Features.FOV, Features.SilentWallCheck, scanKind,
            silentTarget and silentTarget.player, Features.FOV * 1.15)
        if target then
            local c = target.character
            -- Lưu sẵn các bộ phận để hook không phải gọi FindFirstChild (tránh lỗi namecall)
            target.parts = {
                c:FindFirstChild("Head"),
                c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso"),
                c:FindFirstChild("HumanoidRootPart"),
            }
        end
        silentTarget = target
    end

    -- Quyết định "viên đạn" này có bị chỉnh hướng không (tỉ lệ trúng + tỉ lệ headshot).
    -- Quyết định được giữ ~0.03s để các tia raycast của cùng một lần bắn cho kết quả nhất quán,
    -- còn mỗi viên đạn kế tiếp (súng liên thanh) sẽ được quyết định lại và đều được chỉnh hướng.
    local function silentPoint()
        local target = silentTarget
        if not target then return nil end
        local now = os.clock()
        if now - decision.time > 0.03 then
            decision.time = now
            decision.point, decision.part = nil, nil
            local rageHead = Features.RageBot and Features.RageHeadOnly
            local hitChance = Features.RageBot and 100 or Features.SilentHitChance
            local partSetting = rageHead and 1 or Features.SilentPart
            local headChance = rageHead and 100 or Features.SilentHeadChance
            if math.random() * 100 < hitChance then
                local kind = pickKind(partSetting, headChance)
                local part = target.parts and (target.parts[kind] or target.parts[3]) or target.part
                if part and part.Parent then
                    decision.part = part
                    decision.point = part.Position + Vector3.new(0, Features.AimOffset, 0)
                end
            end
        end
        return decision.point, decision.part
    end

    local RAY_METHODS = {
        Raycast = true,
        FindPartOnRay = true,
        FindPartOnRayWithIgnoreList = true,
        FindPartOnRayWithWhitelist = true,
    }
    local CAM_RAY_METHODS = {
        ViewportPointToRay = true,
        ScreenPointToRay = true,
    }
    -- Thống kê để chẩn đoán: bật "Debug Log" trong Silent Aim, mở F9 để xem
    local stats = {calls = 0, redirects = 0, seen = 0}
    local namecallInstalled, fireWatch = false, 0

    local function silentActive()
        return (Features.SilentAim or Features.RageBot) and silentTarget ~= nil
    end

    -- Chỉnh hướng một lời gọi raycast. Trả về danh sách tham số mới, hoặc nil nếu không chỉnh.
    local function redirectArgs(method, args)
        if method == "Raycast" then
            local origin, direction = args[1], args[2]
            if typeof(origin) == "Vector3" and typeof(direction) == "Vector3"
                and direction.Magnitude > 12
                and (origin - Camera.CFrame.Position).Magnitude < 70 then
                stats.calls += 1
                local point = silentPoint()
                if point then
                    stats.redirects += 1
                    local toPoint = point - origin
                    args[2] = toPoint.Unit * math.max(direction.Magnitude, toPoint.Magnitude + 5)
                    return args
                end
            end
        else
            local ray = args[1]
            if typeof(ray) == "Ray" and ray.Direction.Magnitude > 12
                and (ray.Origin - Camera.CFrame.Position).Magnitude < 70 then
                stats.calls += 1
                local point = silentPoint()
                if point then
                    stats.redirects += 1
                    local toPoint = point - ray.Origin
                    args[1] = Ray.new(ray.Origin, toPoint.Unit * math.max(ray.Direction.Magnitude, toPoint.Magnitude + 5))
                    return args
                end
            end
        end
        return nil
    end

    -- Hook __namecall: workspace:Raycast(...), FindPartOnRay*, Camera:ViewportPointToRay(...)
    local function installRaycastHook()
        namecallInstalled = true
        local oldNamecall
        local handler = function(self, ...)
            local method = getnamecallmethod()
            local isRay = RAY_METHODS[method]
            local isCam = CAM_RAY_METHODS[method]
            if (isRay or isCam) and silentActive() and not (checkcaller and checkcaller()) then
                local mode = Features.SilentMode
                if isRay and (mode == 1 or mode == 3) and self == Workspace then
                    local args = redirectArgs(method, table.pack(...))
                    if args then
                        if setnamecallmethod then setnamecallmethod(method) end
                        return oldNamecall(self, unpack(args, 1, args.n))
                    end
                elseif isCam and mode == 4 and self == Workspace.CurrentCamera then
                    local result = oldNamecall(self, ...)
                    if typeof(result) == "Ray" then
                        local point = silentPoint()
                        if point then
                            stats.calls += 1
                            stats.redirects += 1
                            return Ray.new(result.Origin, (point - result.Origin).Unit * result.Direction.Magnitude)
                        end
                    end
                    return result
                end
            end
            return oldNamecall(self, ...)
        end
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
    end

    -- Hook hàm: bắt cả trường hợp game lưu sẵn `local raycast = workspace.Raycast` rồi gọi trực tiếp
    local function installRaycastFunctionHook()
        if not hookfunction then return false end
        local original
        local handler = function(self, origin, direction, ...)
            if original and silentActive() and self == Workspace
                and (Features.SilentMode == 1 or Features.SilentMode == 3)
                and not (checkcaller and checkcaller()) then
                stats.seen += 1
                local args = redirectArgs("Raycast", {origin, direction})
                if args then return original(self, args[1], args[2], ...) end
            end
            return original(self, origin, direction, ...)
        end
        local ok, result = pcall(hookfunction, Workspace.Raycast, newcclosure and newcclosure(handler) or handler)
        if ok and type(result) == "function" then
            original = result
            return true
        end
        return false
    end

    local function installMouseHook()
        local mouse = LocalPlayer:GetMouse()
        local oldIndex
        local handler = function(self, key)
            if (key == "Hit" or key == "Target")
                and (Features.SilentAim or Features.RageBot) and (Features.SilentMode == 2 or Features.SilentMode == 3) and silentTarget
                and self == mouse
                and not (checkcaller and checkcaller()) then
                local point, part = silentPoint()
                if point then
                    if key == "Hit" then return CFrame.new(point) end
                    if part then return part end
                end
            end
            return oldIndex(self, key)
        end
        oldIndex = hookmetamethod(game, "__index", newcclosure and newcclosure(handler) or handler)
    end

    -- Mặc định hook CHỈ hàm Raycast (không đụng tới mọi lệnh gọi trong game như __namecall,
    -- cách này hay gây đơ / crash). Chỉ dùng namecall khi executor thiếu hookfunction,
    -- khi chọn Hook = Namecall, hoặc khi Silent Mode = Camera.
    local function ensureSilentHooks()
        local mode = Features.SilentMode
        if (mode == 1 or mode == 3 or mode == 4) and not raycastHooked then
            raycastHooked = true
            local installed = false
            if Features.SilentHook == 1 and mode ~= 4 and hookfunction then
                local ok, result = pcall(installRaycastFunctionHook)
                installed = ok and result == true
            end
            if not installed then
                if hookmetamethod then
                    local ok, err = pcall(installRaycastHook)
                    installed = ok
                    if not ok then warn("[Khang Hub] Hook namecall lỗi: " .. tostring(err)) end
                end
            end
            if installed then
                print("[Khang Hub] Silent hook OK (" .. (Features.SilentHook == 1 and mode ~= 4 and hookfunction and "Function" or "Namecall") .. ")")
            elseif not warnedNoHook then
                warnedNoHook = true
                showNotification("Silent Aim", "Executor không hỗ trợ hook cần thiết, Silent Aim không hoạt động", 6)
            end
        end
        if (mode == 2 or mode == 3) and not mouseHooked then
            mouseHooked = true
            if hookmetamethod then
                local ok, err = pcall(installMouseHook)
                if not ok then warn("[Khang Hub] Hook mouse lỗi: " .. tostring(err)) end
            end
        end
    end

    -- ---------- Kéo ngắm ----------
    -- Camera.CFrame chỉ đổi hình ảnh, còn hướng bắn của game dựa trên góc ngắm nội bộ (cập nhật theo
    -- chuyển động chuột), nên kéo camera thì cam xoay mà súng không theo. Phương thức Mouse gọi
    -- mousemoverel để chính game xoay góc ngắm => súng và camera cùng theo.
    local aimRemX, aimRemY = 0, 0
    local function applyAim(pos, factor)
        if Features.AimMethod == 1 and mousemoverel then
            local sp = Camera:WorldToViewportPoint(pos)
            local cx, cy = Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2
            local dx, dy
            if sp.Z > 0 then
                dx, dy = sp.X - cx, sp.Y - cy
            else
                local rel = Camera.CFrame:PointToObjectSpace(pos)
                dx, dy = (rel.X >= 0) and 600 or -600, 0
            end
            local scale = math.max(Features.MouseScale, 1) / 100
            aimRemX += dx * factor / scale
            aimRemY += dy * factor / scale
            local mx = math.clamp(aimRemX >= 0 and math.floor(aimRemX) or math.ceil(aimRemX), -250, 250)
            local my = math.clamp(aimRemY >= 0 and math.floor(aimRemY) or math.ceil(aimRemY), -250, 250)
            aimRemX = math.clamp(aimRemX - mx, -1, 1)
            aimRemY = math.clamp(aimRemY - my, -1, 1)
            if mx ~= 0 or my ~= 0 then pcall(mousemoverel, mx, my) end
        else
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), factor)
        end
    end

    -- Đo tự động: 1 đơn vị chuột = bao nhiêu pixel trên màn hình (phụ thuộc độ nhạy / FOV / độ phân giải)
    function Custom.calibrateMouse()
        if not mousemoverel then
            showNotification("Calibrate", "Executor thiếu mousemoverel", 4)
            return
        end
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            showNotification("Calibrate", "Cần đang trong trận (chuột khóa giữa màn hình)", 5)
            return
        end
        task.spawn(function()
            local cam = Workspace.CurrentCamera
            local p = cam.CFrame.Position + cam.CFrame.LookVector * 300
            local before, onBefore = cam:WorldToViewportPoint(p)
            pcall(mousemoverel, 40, 0)
            task.wait(0.12)
            local after, onAfter = cam:WorldToViewportPoint(p)
            pcall(mousemoverel, -40, 0)
            local ppu = (before.X - after.X) / 40
            if onBefore and onAfter and ppu > 0.02 and ppu < 20 then
                Features.MouseScale = math.clamp(math.floor(ppu * 100 + 0.5), 5, 500)
                showNotification("Calibrate", string.format("Mouse Scale = %d (1 đơn vị chuột = %.2f px)", Features.MouseScale, ppu), 5)
                if Custom.syncUI then Custom.syncUI() end
            else
                showNotification("Calibrate", "Không đo được, đứng yên rồi thử lại", 5)
            end
        end)
    end

    -- ---------- Rage Bot: tp tới địch -> bắn -> về chỗ cũ, lặp lại ----------
    Custom.rageTPBusy = false
    task.spawn(function()
        while not khangUnloaded do
            local ran = false
            if Features.RageBot and Features.RageTP
                and (not Features.RageNeedMouseLock or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter)
                and not (Custom.menuVisible and Custom.menuVisible()) then
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local t = silentTarget
                local tChar = t and t.character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHead = tChar and tChar:FindFirstChild("Head")
                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 and tRoot and tHead and tHum and tHum.Health > 0 then
                    ran = true
                    local home = root.CFrame
                    Custom.rageTPBusy = true
                    pcall(function()
                        -- Đứng sau lưng địch, cách Features.RageTPDistance stud
                        local pos = tRoot.Position - tRoot.CFrame.LookVector * Features.RageTPDistance
                            + Vector3.new(0, Features.RageTPHeight, 0)
                        root.CFrame = CFrame.new(pos, Vector3.new(tHead.Position.X, pos.Y, tHead.Position.Z))
                        root.AssemblyLinearVelocity = Vector3.zero
                        task.wait(0.04)
                        for _ = 1, Features.RageTPShots do
                            if khangUnloaded or not tHead.Parent or tHum.Health <= 0 then break end
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHead.Position)
                            doClick()
                            task.wait(0.03)
                        end
                        task.wait(0.02)
                    end)
                    -- Luôn quay về chỗ cũ, kể cả khi có lỗi giữa chừng
                    pcall(function()
                        root.CFrame = home
                        root.AssemblyLinearVelocity = Vector3.zero
                    end)
                    Custom.rageTPBusy = false
                end
            end
            task.wait(ran and math.max(Features.RageTPDelay, 30) / 1000 or 0.05)
        end
    end)

    -- ---------- Aim Assist / Trigger / Auto Clicker ----------
    local aimLockPlayer, aimLockKind = nil, 1
    local triggerBusy = false
    local autoClickTimer = 0
    local rageTimer = 0
    local fovShown, aimCircleShown, debugTimer = false, false, 0
    local scanTimer, aimCache = 0, nil
    local hooksMode, lastFov, lastAimR, lastCenter = nil, nil, nil, nil
    local TargetInfo = Drawing.new("Text")
    TargetInfo.Size = 16
    TargetInfo.Center = true
    TargetInfo.Outline = true
    TargetInfo.Font = 2
    TargetInfo.Visible = false
    local hudTimer, hudPlayer, hudShown, hudPos = 0, nil, false, nil
    local lockTarget = nil

    local function getTriggerTarget()
        local char = LocalPlayer.Character
        if not char then return nil end
        local result = Workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * Features.TriggerDistance, getRayParams())
        if not result then return nil end
        local model = result.Instance:FindFirstAncestorOfClass("Model")
        local humanoid = model and model:FindFirstChildOfClass("Humanoid")
        local player = model and Players:GetPlayerFromCharacter(model)
        if humanoid and humanoid.Health > 0 and player and isEnemy(player) then
            return player
        end
        return nil
    end

    RunService.RenderStepped:Connect(function(dt)
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        -- Chỉ quét tìm mục tiêu theo ScanRate (Low Lag Mode: tối đa 20Hz); vị trí vẫn cập nhật mỗi frame
        scanTimer += dt
        local scanRate = Features.LowLag and math.min(Features.ScanRate, 20) or Features.ScanRate
        local scanDue = scanTimer >= 1 / math.max(scanRate, 1)
        if scanDue then scanTimer = 0 end

        -- Vòng FOV (chỉ ghi Drawing khi đang hiện hoặc vừa đổi trạng thái)
        if Features.SilentAim then
            if lastCenter ~= center then lastCenter = center FOVCircle.Position = center end
            if lastFov ~= Features.FOV then lastFov = Features.FOV FOVCircle.Radius = lastFov end
            if not fovShown then FOVCircle.Visible = true end
            fovShown = true
        elseif fovShown then
            FOVCircle.Visible = false
            fovShown = false
        end
        if Features.Aimbot and Features.AimbotShowCircle then
            AimbotCircle.Position = center
            if lastAimR ~= Features.AimbotFOV then lastAimR = Features.AimbotFOV AimbotCircle.Radius = lastAimR end
            if not aimCircleShown then AimbotCircle.Visible = true end
            aimCircleShown = true
        elseif aimCircleShown then
            AimbotCircle.Visible = false
            aimCircleShown = false
        end

        -- Debug Silent Aim: in thống kê mỗi 2 giây (mở F9)
        if Features.SilentDebug then
            debugTimer += dt
            if debugTimer >= 2 then
                debugTimer = 0
                print(string.format("[Khang Silent] ray_calls=%d redirects=%d target=%s mode=%d",
                    stats.calls, stats.redirects,
                    silentTarget and silentTarget.player.Name or "none", Features.SilentMode))
                stats.calls, stats.redirects = 0, 0
            end
        end

        -- Aim Assist (kéo camera, có độ dính) - tìm mục tiêu theo ScanRate, camera vẫn mượt mỗi frame
        local aimTarget = nil
        if Features.Aimbot then
            local holding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            if not Features.HoldRMB or holding then
                if not aimLockPlayer then
                    aimLockKind = pickKind(Features.AimPart, Features.AimPart == 4 and 50 or 100)
                end
                if scanDue or not aimCache then
                    aimCache = findTarget(Features.MaxDistance, Features.AimbotFOV, Features.WallCheck, aimLockKind,
                        aimLockPlayer, Features.AimbotFOV * (1 + Features.AimbotSticky / 50))
                end
                local target = aimCache
                if target and target.part.Parent then
                    target.position = target.part.Position + Vector3.new(0, Features.AimOffset, 0)
                    aimLockPlayer = target.player
                    aimTarget = target
                    local base = math.clamp(1 - (Features.AimbotSmooth / 101), 0.01, 1)
                    local factor = base + (1 - base) * (Features.AimbotSticky / 100) * 0.5
                    applyAim(target.position, factor)
                else
                    aimCache, aimLockPlayer = nil, nil
                end
            else
                aimCache, aimLockPlayer = nil, nil
            end
        else
            aimCache, aimLockPlayer = nil, nil
        end

        -- Aim Lock: khóa cứng camera vào mục tiêu tới khi nhả phím / mục tiêu chết / ra khỏi tầm
        if Features.AimLock and (not Features.LockHold or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
            local t = lockTarget
            if t then
                local alive = t.hum and t.hum.Health > 0 and t.part.Parent and t.player.Parent
                if alive and scanDue then
                    alive = (t.part.Position - Camera.CFrame.Position).Magnitude <= Features.LockRange
                        and (not Features.LockWall or isVisible(t.part, t.character))
                end
                if not alive then t = nil end
            end
            if not t and scanDue then
                t = findTarget(Features.LockRange, Features.LockFOV, Features.LockWall,
                    pickKind(Features.LockPart, Features.LockPart == 4 and 50 or 100), nil, nil)
                if t then t.hum = t.character:FindFirstChildOfClass("Humanoid") end
            end
            lockTarget = t
            if t then
                local pos = t.part.Position + Vector3.new(0, Features.AimOffset, 0)
                if Features.LockPredict > 0 then
                    pos += t.part.AssemblyLinearVelocity * (Features.LockPredict / 1000)
                end
                applyAim(pos, Features.LockSmooth <= 0 and 1 or math.clamp(1 - Features.LockSmooth / 101, 0.02, 1))
                t.position = pos
                aimTarget = t
            end
        else
            lockTarget = nil
        end

        -- Silent Aim
        -- Đang bắn mà hook hàm không thấy tia nào => executor không bắt được đạn qua hook hàm, tự chuyển sang Namecall
        if Features.SilentAim and raycastHooked and not namecallInstalled and Features.SilentHook == 1
            and silentTarget and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            fireWatch += dt
            if fireWatch > 1.2 and stats.seen == 0 then
                namecallInstalled = true
                task.spawn(function()
                    local ok = pcall(installRaycastHook)
                    showNotification("Silent Aim", ok and "Hook hàm không bắt được đạn, đã chuyển sang Namecall" or "Không cài được hook Namecall", 5)
                end)
            end
        else
            fireWatch = 0
        end

        -- Cài hook ở luồng riêng, chỉ khi bật lần đầu / đổi mode (trước đây chạy ngay trong frame render nên bị đơ)
        if (Features.SilentAim or Features.RageBot) and hooksMode ~= Features.SilentMode then
            hooksMode = Features.SilentMode
            task.spawn(ensureSilentHooks)
        end
        if Features.RageBot then
            if scanDue then silentTarget = findRageTarget() end
        else
            if scanDue then updateSilentTarget() end
        end
        if silentTarget then
            if silentTarget.part.Parent then
                silentTarget.position = silentTarget.part.Position
            else
                silentTarget = nil
            end
        end
        setAutoFire(Features.SilentAim and not Features.RageBot and Features.SilentAutoFire and silentTarget ~= nil)

        -- Rage Bot: tự bắn + (tuỳ chọn) kéo camera thẳng vào mục tiêu
        local rageLocked = not Features.RageNeedMouseLock or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
        if Features.RageBot and silentTarget and rageLocked then
            if Features.RageSnap and not Features.RageTP then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, silentTarget.position)
            end
            if Features.RageAutoFire and not Features.RageTP then
                rageTimer += dt
                local rageInterval = 1 / math.max(Features.RageCPS, 1)
                if rageTimer >= rageInterval then
                    rageTimer = math.min(rageTimer - rageInterval, rageInterval)
                    if not (Custom.menuVisible and Custom.menuVisible()) then
                        doClick()
                    end
                end
            end
        else
            rageTimer = 0
        end

        -- Hiện mục tiêu
        local shown = silentTarget or aimTarget
        if Features.ShowTarget and shown then
            local sp, onScreen = Camera:WorldToViewportPoint(shown.position)
            TargetMarker.Position = Vector2.new(sp.X, sp.Y)
            TargetMarker.Visible = onScreen
        else
            TargetMarker.Visible = false
        end

        -- HUD máu mục tiêu
        if Features.ShowTargetInfo and shown and shown.character then
            hudTimer += dt
            if hudTimer >= 0.1 or hudPlayer ~= shown.player then
                hudTimer = 0
                hudPlayer = shown.player
                local hum = shown.character:FindFirstChildOfClass("Humanoid")
                if hum then
                    local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                    TargetInfo.Text = string.format("%s   %d/%d HP", shown.player.Name, math.floor(hum.Health), math.floor(hum.MaxHealth))
                    TargetInfo.Color = Color3.fromHSV(pct * 0.33, 1, 1)
                end
            end
            local pos = Vector2.new(center.X, center.Y + (Features.SilentAim and Features.FOV or 100) + 14)
            if hudPos ~= pos then hudPos = pos TargetInfo.Position = pos end
            if not hudShown then TargetInfo.Visible = true hudShown = true end
        elseif hudShown then
            TargetInfo.Visible = false
            hudShown = false
        end

        -- Trigger Bot
        if Features.TriggerBot and not triggerBusy then
            if not Features.TriggerRMB or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                if getTriggerTarget() then
                    triggerBusy = true
                    task.spawn(function()
                        local delayMs = Features.TriggerDelay
                        if delayMs > 0 then task.wait(delayMs / 1000) end
                        if Features.TriggerBot and getTriggerTarget() then
                            doClick()
                        end
                        task.wait(0.08)
                        triggerBusy = false
                    end)
                end
            end
        end

        -- Auto Clicker (click liên tục khi bật; tạm dừng khi menu đang mở)
        if Features.AutoClicker then
            autoClickTimer += dt
            local interval = 1 / math.max(Features.AutoClickCPS, 1)
            if autoClickTimer >= interval then
                autoClickTimer = math.min(autoClickTimer - interval, interval)
                if not (Custom.menuVisible and Custom.menuVisible()) then
                    doClick()
                end
            end
        else
            autoClickTimer = 0
        end
    end)
end

