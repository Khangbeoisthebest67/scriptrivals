local bodyConnections = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
}

local function createESP(player)
    if player == LocalPlayer or khangUnloaded then return end
    
    local objects = {}
    
    for i = 1, 14 do
        local line = Drawing.new("Line")
        line.Thickness = 1.5
        line.Transparency = 0.8
        line.Visible = false
        table.insert(objects, line)
    end
    
    local headCircle = Drawing.new("Circle")
    headCircle.Thickness = 2
    headCircle.NumSides = 12
    headCircle.Radius = 4
    headCircle.Filled = true
    headCircle.Visible = false
    table.insert(objects, headCircle)
    
    local tracer = Drawing.new("Line")
    tracer.Thickness = 1
    tracer.Transparency = 0.5
    tracer.Visible = false
    table.insert(objects, tracer)
    
    local infoText = Drawing.new("Text")
    infoText.Size = 13
    infoText.Center = true
    infoText.Outline = true
    infoText.Font = 2
    infoText.Visible = false
    table.insert(objects, infoText)
    
    -- Thanh máu (nền + phần máu)
    local barBg = Drawing.new("Line")
    barBg.Thickness = 4
    barBg.Color = Color3.fromRGB(15, 15, 15)
    barBg.Transparency = 0.7
    barBg.Visible = false
    table.insert(objects, barBg)

    local barFill = Drawing.new("Line")
    barFill.Thickness = 2
    barFill.Visible = false
    table.insert(objects, barFill)

    espObjects[player] = {objects = objects}
end

local function removeESP(player)
    if espObjects[player] then
        for _, obj in pairs(espObjects[player].objects) do
            pcall(function() obj:Remove() end)
        end
        espObjects[player] = nil
    end
end

Players.PlayerRemoving:Connect(removeESP)

for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        createESP(player)
    end
end

Players.PlayerAdded:Connect(createESP)

local ESP_RED, ESP_GREEN = Color3.fromRGB(255, 50, 50), Color3.fromRGB(50, 255, 50)
local espAccum = 0

local function hideESP(data)
    if data.hidden then return end
    data.hidden = true
    data.skeletonHidden = true
    data.vis = {}
    for _, obj in pairs(data.objects) do obj.Visible = false end
end

-- Chỉ ghi vào Drawing khi giá trị thật sự đổi (mỗi lần ghi Drawing rất tốn)
local function espVis(data, obj, value)
    local vis = data.vis
    if vis[obj] ~= value then
        vis[obj] = value
        obj.Visible = value
    end
end

local function espColor(data, obj, color)
    local colors = data.colors
    if colors[obj] ~= color then
        colors[obj] = color
        obj.Color = color
    end
end

-- Cache các bộ phận của nhân vật, làm mới 2 giây/lần (tránh FindFirstChild mỗi frame)
local function getEspParts(data, character, now)
    if data.partChar ~= character or now >= (data.partUntil or 0) then
        data.partChar = character
        data.partUntil = now + 2
        local parts = {}
        for _, conn in ipairs(bodyConnections) do
            parts[conn[1]] = character:FindFirstChild(conn[1])
            parts[conn[2]] = character:FindFirstChild(conn[2])
        end
        parts.Head = character:FindFirstChild("Head")
        parts.HumanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        parts.Humanoid = character:FindFirstChildOfClass("Humanoid")
        data.parts = parts
    end
    return data.parts
end

local projP, projOn = {}, {}
local function proj(part)
    local p = projP[part]
    if p == nil then
        local v, on = Camera:WorldToViewportPoint(part.Position)
        projP[part], projOn[part] = v, on
        return v, on
    end
    return p, projOn[part]
end

RunService.RenderStepped:Connect(function(dt)
    -- ESP tắt: ẩn một lần rồi thoát
    if not Features.ESP then
        for _, data in pairs(espObjects) do hideESP(data) end
        espAccum = 0
        return
    end

    -- Giới hạn tốc độ cập nhật ESP (Low Lag Mode: tối đa 30Hz)
    espAccum += dt
    local rate = Features.LowLag and math.min(Features.ESPRate, 30) or Features.ESPRate
    if espAccum < 1 / math.max(rate, 1) then return end
    espAccum = 0

    local now = os.clock()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local showSkeleton = Features.ShowSkeleton and not Features.LowLag
    local viewport = Camera.ViewportSize
    local tracerFrom = Vector2.new(viewport.X / 2, viewport.Y)

    for player, data in pairs(espObjects) do
        data.vis = data.vis or {}
        data.colors = data.colors or {}
        table.clear(projP)
        table.clear(projOn)

        local character = player.Character
        local parts = character and getEspParts(data, character, now)
        local humanoid = parts and parts.Humanoid
        local hrp = parts and parts.HumanoidRootPart
        local shown = false

        if myRoot and humanoid and humanoid.Health > 0 and hrp and hrp.Parent then
            local distance = (hrp.Position - myRoot.Position).Magnitude
            if distance <= Features.MaxDistance then
                shown = true
                data.hidden = false
                local objects = data.objects
                local color = isEnemy(player) and ESP_RED or ESP_GREEN

                -- Skeleton
                if showSkeleton then
                    data.skeletonHidden = false
                    for i, conn in ipairs(bodyConnections) do
                        local line = objects[i]
                        local part1, part2 = parts[conn[1]], parts[conn[2]]
                        if part1 and part2 then
                            local p1, on1 = proj(part1)
                            local p2, on2 = proj(part2)
                            if on1 or on2 then
                                line.From = Vector2.new(p1.X, p1.Y)
                                line.To = Vector2.new(p2.X, p2.Y)
                                espColor(data, line, color)
                                espVis(data, line, true)
                            else
                                espVis(data, line, false)
                            end
                        else
                            espVis(data, line, false)
                        end
                    end
                elseif not data.skeletonHidden then
                    data.skeletonHidden = true
                    for i = 1, 14 do espVis(data, objects[i], false) end
                end

                local head = parts.Head

                -- Head dot
                local headCircle = objects[15]
                if Features.ShowHeadDot and head then
                    local hp, onScreen = proj(head)
                    if onScreen then
                        headCircle.Position = Vector2.new(hp.X, hp.Y)
                        espColor(data, headCircle, color)
                        espVis(data, headCircle, true)
                    else
                        espVis(data, headCircle, false)
                    end
                else
                    espVis(data, headCircle, false)
                end

                -- Tracer
                local tracer = objects[16]
                if Features.ShowTracer then
                    local rp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        tracer.From = tracerFrom
