                Text = tostring(opt),
                TextSize = 12,
                Font = Enum.Font.Gotham,
                LayoutOrder = i,
            }, list)
            optionButtons[opt] = b
            b.MouseButton1Click:Connect(function()
                obj:Set(opt)
                list.Visible = false
            end)
        end
        visual()
    end

    header.MouseButton1Click:Connect(function() list.Visible = not list.Visible end)

    obj:SetOptions(options)
    win:_register(o.Flag, value, function(v) obj:Set(v) end)
